            </a>

            <a href="/DangKy/Index" class="main-btn register">
                <i class="fa-solid fa-user-plus"></i>
                Đăng ký
            </a>

        </div>

    </header>

    <!-- DANH MỤC -->

    <div class="category">

        <a asp-controller="Danhmuc"
           asp-action="List"
           asp-route-id="1"
           asp-route-returnController="Giaodien">
