@model List<duan_totnghiep.Models.Giohang>
@{
    Layout = "_LayoutAdmin";
}
@{
    ViewData["Title"] = "Giỏ hàng";
}
<style>
    body {
        background: #f4f6fb;
        font-family: Arial, sans-serif;
    }

    .title {
        text-align: center;
        margin: 35px 0;
        font-size: 42px;
        font-weight: bold;
        color: #111;
        letter-spacing: 2px;
    }

    .cart-container {
        width: 92%;
        margin: auto;
        background: #fff;
        border: 3px solid #111; /* Giữ viền đen */
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 18px 45px rgba(0,0,0,.12);
    }

    /*================ TABLE ================*/

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #111;
        color: #fff;
        padding: 20px;
        font-size: 18px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    td {
        padding: 20px;
        text-align: center;
        border-bottom: 1px solid #ddd;
        transition: .25s;
    }

    tr:hover {
        background: #f8f9ff;
    }

    td img {
        width: 95px;
        height: 95px;
        object-fit: cover;
        border-radius: 12px;
        border: 2px solid #111;
    }

    /*================ GIÁ ================*/

    .price {
        font-size: 20px;
        font-weight: bold;
        color: #e63946;
    }

    /*================ SỐ LƯỢNG ================*/

    .quantity {
        font-size: 18px;
        font-weight: bold;
    }

        .quantity a {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: #111;
            color: white;
            text-decoration: none;
            transition: .25s;
        }

            .quantity a:hover {
                background: #2563eb;
                transform: scale(1.1);
            }

    /*================ XÓA ================*/

    .btn-delete {
        display: inline-block;
        padding: 10px 18px;
        border-radius: 10px;
        background: #ef4444;
        color: white;
        text-decoration: none;
        font-weight: bold;
        transition: .3s;
    }

        .btn-delete:hover {
            background: #dc2626;
            transform: translateY(-2px);
        }

    /*================ EMPTY ================*/

    .empty-cart {
        font-size: 28px;
        color: #e63946;
        padding: 70px;
    }

    /*================ BUTTONS ================*/

    .cart-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px 30px;
        border-top: 2px solid #111;
        background: #fafafa;
    }

    .button-group {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .total-box {
        flex: 1;
        font-size: 28px;
        font-weight: bold;
    }

        .total-box span {
            color: #e63946;
            margin-left: 10px;
        }

    .btn-home,
    .btn-clear,
    .btn-payment {
        width: 220px;
        height: 52px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        border-radius: 10px;
        text-decoration: none;
        color: #fff;
        font-weight: bold;
    }

    .btn-home {
        background: #2563eb;
    }

        .btn-home:hover {
            background: #1d4ed8;
            transform: translateY(-3px);
        }

    .btn-clear {
        background: #111;
    }

        .btn-clear:hover {
            background: #333;
            transform: translateY(-3px);
        }

    .btn-payment {
        background: #16a34a;
    }

        .btn-payment:hover {
            background: #15803d;
            transform: translateY(-3px);
        }
        /*Banner mới*/
    .cart-banner {
        width: 92%;
        margin: 30px auto 25px;
        background: linear-gradient(135deg,#111,#2b2b2b);
        color: white;
        border-radius: 18px;
        padding: 25px 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 12px 30px rgba(0,0,0,.18);
    }

    .banner-left h2 {
        margin: 0;
        font-size: 34px;
    }

    .banner-left p {
        margin-top: 8px;
        color: #d1d5db;
    }

    .banner-right i {
        font-size: 70px;
        color: #ffd54f;
    }

    .btn-history {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #189;
        color: white;
        text-decoration: none;
        padding: 12px 20px;
        border-radius: 10px;
        font-weight: bold;
        transition: .3s;
    }

        .btn-history:hover {
            background: #158;
            transform: translateY(-2px);
        }
    /* ================= NÚT ĐƠN HÀNG CỦA TÔI ================= */

    .btn-my-order {
        height: 50px;
        padding: 0 28px;
        border-radius: 12px;
        border: 2px solid #2563eb;
        background: white;
        color: #2563eb;
        font-size: 16px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-decoration: none;
        transition: .25s;
    }


        .btn-my-order:hover {
            background: #2563eb;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(37,99,235,.25);
        }



    /* Nút thanh toán nếu cần đồng bộ */


    .btn-my-order {
        height: 50px;
        padding: 0 28px;
        border-radius: 12px;
        border: 2px solid #2563eb;
        background: white;
        color: #2563eb;
        font-size: 16px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-decoration: none;
        transition: .25s;
    }


        .btn-my-order:hover {
            background: #2563eb;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(37,99,235,.25);
        }

    .quantity select,
    td select {
        width: 75px;
        height: 38px;
        border: 2px solid #111;
        border-radius: 8px;
        text-align: center;
        font-weight: bold;
        cursor: pointer;
    }
</style>

<div class="cart-banner">

    <div class="banner-left">
        <h2>🛒 Giỏ hàng của bạn</h2>
        <p>Kiểm tra sản phẩm trước khi tiến hành thanh toán.</p>
    </div>
    <div class="banner-right">

        <a asp-action="LichSu"
           class="btn-history">
            <i class="fa-solid fa-box"></i>
            Lịch sử mua hàng
        </a>

    </div>
    <div class="banner-right">
        <i class="fa-solid fa-cart-shopping"></i>
    </div>

</div>

<div class="cart-container">

    <table>

        <tr>
            <th>Hình ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Size</th>
            <th>Đơn giá</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
            <th>Thao tác</th>
        </tr>

        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="7" class="empty-cart">
                    🛒 Giỏ hàng trống
                </td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        <img src="~/images/@item.Sanpham.Hinhanh" />
                    </td>

                    <td>
                        @item.Sanpham.Tensp
                    </td>

                    <td>

                        <form asp-action="DoiSize" method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Magh" />

                            <select name="size"
                                    onchange="this.form.submit()">

                                @for (int i = 38; i <= 43; i++)
                                {
                                    if (item.Size == i.ToString())
                                    {
                                        <option value="@i" selected>@i</option>
                                    }
                                    else
                                    {
                                        <option value="@i">@i</option>
                                    }
                                }

                            </select>

                        </form>

                    </td>

                    <td>
                        @{
                            decimal gia = item.Sanpham.Gia;

                            if (item.Sanpham.Khuyenmai != null &&
                            item.Sanpham.Khuyenmai.TrangThaiHienThi == "Hoạt động")
                            {
                                gia = gia * (100 - item.Sanpham.Khuyenmai.Phantramgiam) / 100;

                                <div>
                                    <span style="font-size:12px;color:#999;text-decoration:line-through;">
                                        @string.Format("{0:N0}", item.Sanpham.Gia) đ
                                    </span>
                                    <br />
                                    <span style="font-size:20px;font-weight:bold;color:red;">
                                        @string.Format("{0:N0}", gia) đ
                                    </span>
                                </div>
                            }
                            else
                            {
                                @string.Format("{0:N0}", gia)
                                <text> đ</text>
                            }
                        }
                    </td>

                    <td class="quantity">

                        <a asp-action="Giam"
                           asp-route-id="@item.Magh">
                            -
                        </a>

                        @item.Soluong

                        <a asp-action="Tang"
                           asp-route-id="@item.Magh">
                            +
                        </a>

                    </td>

                    <td>
                        @{
                            decimal Gia = item.Sanpham.Gia;

                            if (item.Sanpham.Khuyenmai != null &&
                            item.Sanpham.Khuyenmai.TrangThaiHienThi == "Hoạt động")
                            {
                                Gia = Gia * (100 - item.Sanpham.Khuyenmai.Phantramgiam) / 100;
                            }
                        }

                        @string.Format("{0:N0}", Gia * item.Soluong) đ
                    </td>

            <td>

                <a asp-action="Xoa"
                   asp-route-id="@item.Magh"
                   onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này không?');"
                   class="btn-delete">
                    Xóa
                </a>
                        
            </td>

        </tr>
                }
        }

    </table>

    <div class="cart-footer">

        <div class="total-box">

            Tổng tiền:
            <span>
                @Model.Sum(x =>
                {
                    decimal gia = x.Sanpham.Gia;

                    if (x.Sanpham.Khuyenmai != null)
                    {
                        gia -= gia * x.Sanpham.Khuyenmai.Phantramgiam / 100m;
                    }

                    return gia * x.Soluong;
                }).ToString("N0") đ
            </span>

        </div>

        <div class="button-group">

            <a asp-action="XoaHet"
               class="btn-clear">
                🗑 Xóa tất cả
            </a>

            <a asp-controller="Trangmua"
               asp-action="Index"
               class="btn-home">
                🏠 Tiếp tục mua
            </a>

            <a asp-controller="Thanhtoan"
               asp-action="Index"
               class="btn-payment">
                💳 Thanh toán
            </a>
            <a asp-controller="Donhang"
               asp-action="CuaToi"
               class="btn-my-order">

                <i class="fa-solid fa-box"></i>
                Đơn hàng của tôi

            </a>
        </div>

    </div>
</div>