                <i class="fa-solid fa-star"></i>
            </div>
            <div class="old-price">320.000đ</div>
            <div class="price">250.000đ</div>
        </div>

        <div class="card">
            <div class="sale-badge">-40%</div>
            <img src="~/images/shoes3.webp" />
            <h3>Giày Convert chuck</h3>
            <div class="rating">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
            </div>
