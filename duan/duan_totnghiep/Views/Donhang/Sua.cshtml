@model duan_totnghiep.Models.Donhang

@{
    Layout = "_Layout";
}

<div class="form-container">

    <h2>Cập nhật đơn hàng</h2>

    <form asp-action="Sua" method="post">

        <input type="hidden" asp-for="Madh" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label>Mã đơn hàng</label>
            <input value="@Model.Madh" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label>Khách hàng</label>
            <input value="@Model.Khachhang?.Hoten" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label>Ngày đặt</label>
            <input value="@Model.Ngaydat?.ToString("dd/MM/yyyy")"
                   class="form-control"
                   readonly />
        </div>

        <div class="form-group">
            <label>Nhân viên phụ trách</label>

            <select asp-for="Manv"
                    asp-items="ViewBag.NhanVien"
                    class="form-select">
            </select>
        </div>

        <div class="mt-4 d-flex gap-2">

            <button type="submit" class="btn btn-add">
                Lưu
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Quay lại
            </a>

        </div>

    </form>

</div>