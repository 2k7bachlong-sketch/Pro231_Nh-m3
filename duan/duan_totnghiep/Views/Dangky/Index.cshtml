@model duan_totnghiep.Models.Taikhoan
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký";
}
<!DOCTYPE html>
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<html>
<head>
    <meta charset="utf-8" />
    <title>Đăng ký</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #eee;
            font-family: Arial;
        }

        .header {
            width: 92%;
            height: 90px;
            margin: 20px auto 12px;
            background: grey;
            border-radius: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 35px;
            box-shadow: 0 15px 40px rgba(0,0,0,.18);
        }

        .logo {
            width: 90px;
            transition: .3s;
        }

            .logo:hover {
                transform: scale(1.08);
            }

        .container {
            width: 1400px;
            max-width: 95%;
            margin: 50px auto;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 90px;
        }

        .left {
            width: 520px; /* bỏ flex:1 */
            flex: none;
            text-align: center;
        }

            .left img {
                width: 330px;
                margin-bottom: 20px;
            }

            .left h1 {
                font-size: 58px;
                margin-bottom: 15px;
                font-weight: 800;
            }

            .left p {
                font-size: 26px;
                color: #666;
                margin-bottom: 50px;
            }

        .form-group {
            position: relative;
            margin-bottom: 18px;
        }

            .form-group input {
                width: 100%;
                height: 58px;
                border: 1px solid #ddd;
                border-radius: 15px;
                padding-left: 18px;
                padding-right: 50px;
                font-size: 18px;
                transition: .3s;
            }

                .form-group input:focus {
                    border-color: #ff4040;
                    outline: none;
                    box-shadow: 0 0 10px rgba(255,64,64,.15);
                }

        .toggle-password {
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #888;
        }

            .toggle-password:hover {
                color: #111;
            }

        .feature {
            display: flex;
            align-items: center;
            margin: 25px 0;
        }

        .feature-icon {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 5px 20px rgba(0,0,0,.08);
            display: flex;
            justify-content: center;
            align-items: center;
            color: #ff4040;
            font-size: 28px;
            margin-right: 22px;
        }

        .feature h3 {
            font-size: 34px;
        }

        .feature span {
            color: #777;
            font-size: 20px;
        }

        .register-box {
            width: 500px;
            background: #fff;
            padding: 45px;
            border-radius: 28px;
            box-shadow: 0 20px 45px rgba(0,0,0,.12);
        }

        .title {
            font-size: 58px;
            font-weight: 800;
            text-align: center;
            margin-bottom: 10px;
        }

            .title::after {
                content: "";
                display: block;
                width: 80px;
                height: 4px;
                background: #ff3b3b;
                margin: 18px auto 35px;
                border-radius: 50px;
            }

        .form-group {
            margin-bottom: 18px;
        }

            .form-group input {
                width: 100%;
                height: 58px;
                border: 1px solid #ddd;
                border-radius: 15px;
                padding-left: 18px;
                font-size: 18px;
                transition: .3s;
            }

                .form-group input:focus {
                    border-color: #ff4040;
                    outline: none;
                    box-shadow: 0 0 10px rgba(255,64,64,.15);
                }

        .btnDangKy {
            width: 100%;
            height: 60px;
            border: none;
            border-radius: 15px;
            background: #111;
            color: white;
            font-size: 22px;
            font-weight: bold;
            margin-top: 10px;
            transition: .3s;
        }

            .btnDangKy:hover {
                background: #ff4040;
            }

        .login-link {
            text-align: center;
            margin-top: 25px;
            font-size: 18px;
        }

            .login-link a {
                color: #ff4040;
                text-decoration: none;
                font-weight: bold;
            }

        .back-home {
            margin-top: 15px;
            text-align: center;
        }

            .back-home a {
                text-decoration: none;
                color: #666;
            }

                .back-home a:hover {
                    color: #ff4040;
                }
        
        .error-box {
            width: 100%;
            padding: 16px 20px;
            margin: 20px 0;
            background: #ffe8e8;
            color: #d80027;
            border: 1px solid #ffb7b7;
            border-radius: 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 18px;
            font-weight: 500;
            animation: fadeDown .35s ease;
        }

            .error-box i {
                font-size: 22px;
                color: #ff3b3b;
            }

        .header-center {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            text-align: center;
        }

            .header-center h1 {
                margin: 0;
                font-size: 52px;
                font-weight: 900;
                color: black;
                letter-spacing: 2px;
                text-transform: uppercase;
                font-family: 'Arial Black',sans-serif;
                text-shadow: 0 4px 12px rgba(0,0,0,.25);
                line-height: 1;
            }

            .header-center span {
                display: block;
                margin-top: 6px;
                color: white;
                font-size: 15px;
                letter-spacing: 6px;
                text-transform: uppercase;
                font-weight: 600;
            }

        .header {
            position: relative;
        }

        .header-back {
            position: absolute;
            right: 35px;
            top: 50%;
            transform: translateY(-50%);
        }

            .header-back a {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 12px 22px;
                border-radius: 30px;
                background: #ffffff;
                color: #111827;
                text-decoration: none;
                font-weight: 700;
                transition: .3s;
                box-shadow: 0 6px 18px rgba(0,0,0,.15);
            }

                .header-back a:hover {
                    background: #f3f4f6;
                    color: #000;
                    transform: translateY(-2px);
                }

            .header-back i {
                font-size: 16px;
            }
    </style>
</head>

<body>
    <div class="header">

        <a href="/Giaodien/Index">
            <img src="/images/starlogo.png" class="logo">
        </a>
        <div class="header-center">

            <h1>StarPard Shop</h1>

            <span>CHÍNH HÃNG • UY TÍN • CHẤT LƯỢNG</span>

        </div>

        <div class="header-back">
            <a asp-controller="Giaodien" asp-action="Index">
                <i class="fa-solid fa-house"></i>
                Trang chủ
            </a>
        </div>
    </div>

    <div class="container">

        <div class="left">

            <a href="/Giaodien/Index">
                <img src="/images/starlogo.png" class="logo">
            </a>

            <h1>StarPard Shop</h1>

            <p>Shop bán giày uy tín chính hãng hàng đầu Việt Nam</p>

            <div class="feature">
                <div class="feature-icon">🛡️</div>

                <div>
                    <h3>100% Chính hãng</h3>
                    <span>Cam kết chất lượng</span>
                </div>
            </div>

            <div class="feature">
                <div class="feature-icon">🚚</div>

                <div>
                    <h3>Giao hàng toàn quốc</h3>
                    <span>Miễn phí đơn từ 500K</span>
                </div>
            </div>

            <div class="feature">
                <div class="feature-icon">🔄</div>

                <div>
                    <h3>Đổi trả 7 ngày</h3>
                    <span>Hoàn tiền nếu lỗi</span>
                </div>
            </div>

        </div>

        <div class="register-box">

            <h2 class="title">Đăng ký</h2>

            @if (ViewBag.Loi != null)
{
    <div class="error-box">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@ViewBag.Loi</span>
    </div>
}

            <form asp-action="DangKy" method="post">

                <div class="form-group">
                    <input type="text"
                           name="TenDangNhap"
                           placeholder="Tên đăng tài khoản" />
                </div>

                <div class="form-group">
                    <input type="text"
                           name="SoDienThoai"
                           placeholder="SĐT" />
                </div>
                <div class="form-group">
                    <input type="email"
                           name="Email"
                           placeholder="Email"
                           required />
                </div>

                <div class="form-group">

                    <input type="password"
                           id="registerPassword"
                           name="MatKhau"
                           placeholder="Mật khẩu" />

                    <i class="fa-solid fa-eye toggle-password"
                       data-target="registerPassword"></i>

                </div>
                <div class="form-group">

                    <input type="password"
                           id="confirmPassword"
                           name="NhapLaiMatKhau"
                           placeholder="Nhập lại mật khẩu" />

                    <i class="fa-solid fa-eye toggle-password"
                       data-target="confirmPassword"></i>

                </div>

                <button type="submit" class="btnDangKy">
                    Đăng ký
                </button>

                <div class="login-link">
                    Đã có tài khoản?
                    <a href="/Taikhoan/Index">
                        Đăng nhập ngay
                    </a>
                </div>

                <div class="back-home">
                    <a href="/Giaodien/Index">
                        ← Quay về trang chủ
                    </a>
                </div>

            </form>

        </div>

    </div>

</body>
<script>
    document.querySelectorAll(".toggle-password").forEach(icon => {

        icon.addEventListener("click", function () {

            const input = document.getElementById(this.dataset.target);

            if (input.type === "password") {
                input.type = "text";
                this.classList.replace("fa-eye", "fa-eye-slash");
            } else {
                input.type = "password";
                this.classList.replace("fa-eye-slash", "fa-eye");
            }

        });

    });
</script>
</html>
