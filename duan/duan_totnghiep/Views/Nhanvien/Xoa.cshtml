@model duan_totnghiep.Models.Nhanvien

@{
    Layout = "_Layout";
}

<div class="delete-container">

    <h2>Xóa nhân viên</h2>

    <p>

        Bạn có chắc chắn muốn xóa nhân viên này?

    </p>

    <hr />

    <p>

        <strong>Mã:</strong>

        #@Model.Manv

    </p>

    <p>

        <strong>Họ tên:</strong>

        @Model.Hoten

    </p>

    <p>

        <strong>SĐT:</strong>

        @Model.Sdt

    </p>

    <p>

        <strong>Email:</strong>

        @Model.Email

    </p>

    <p>

        <strong>Địa chỉ:</strong>

        @Model.Diachi

    </p>

    <p>

        <strong>Chức vụ:</strong>

        @Model.Chucvu

    </p>

    <form asp-action="Xoa"
          method="post">

        <input asp-for="Manv"
               type="hidden" />

        <button class="btn btn-delete">

            <i class="bi bi-trash-fill"></i>

            Xóa

        </button>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>

            Hủy

        </a>

    </form>

</div>