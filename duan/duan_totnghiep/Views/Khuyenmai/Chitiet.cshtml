@model duan_totnghiep.Models.Khuyenmai

@{
    Layout = "_Layout";
}

<div class="container py-4">

    <!-- Header -->
    <div class="card border-0 shadow-lg rounded-4 mb-4">

        <div class="card-body d-flex justify-content-between align-items-center">

            <div>

                <span class="badge bg-primary mb-2">
                    CHI TIẾT
                </span>

                <h2 class="fw-bold mb-1">
                    🎁 @Model.Tenkm
                </h2>

                <p class="text-muted mb-0">
                    Thông tin chi tiết chương trình khuyến mãi
                </p>

            </div>

            <div>

                @if (Model.TrangThaiHienThi == "Hoạt động")
                {
                    <span class="badge bg-success fs-6 px-3 py-2">
                        🟢 Hoạt động
                    </span>
                }
                else if (Model.TrangThaiHienThi == "Sắp diễn ra")
                {
                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                        🟡 Sắp diễn ra
                    </span>
                }
                else
                {
                    <span class="badge bg-danger fs-6 px-3 py-2">
                        🔴 Đã kết thúc
                    </span>
                }

                <p class="text-muted mt-2 mb-0">
                    ⏳ @Model.ThongTinTrangThai
                </p>
            </div>
            

        </div>

    </div>

    <!-- Nội dung -->

    <div class="card border-0 shadow rounded-4">

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-6">

                    <div class="border rounded-3 p-3">

                        <small class="text-muted">
                            Mã khuyến mãi
                        </small>

                        <h5 class="mb-0 mt-2">
                            #@Model.Makm
                        </h5>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="border rounded-3 p-3">

                        <small class="text-muted">
                            Phần trăm giảm
                        </small>

                        <h5 class="mb-0 mt-2 text-success">
                            @Model.Phantramgiam %
                        </h5>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="border rounded-3 p-3">

                        <small class="text-muted">
                            Ngày bắt đầu
                        </small>

                        <h5 class="mb-0 mt-2">
                            @Model.Ngaybatdau?.ToString("dd/MM/yyyy")
                        </h5>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="border rounded-3 p-3">

                        <small class="text-muted">
                            Ngày kết thúc
                        </small>

                        <h5 class="mb-0 mt-2">
                            @Model.Ngayketthuc?.ToString("dd/MM/yyyy")
                        </h5>

                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Quay lại

                </a>

                <a asp-action="Sua"
                   asp-route-id="@Model.Makm"
                   class="btn btn-warning">

                    <i class="bi bi-pencil-square"></i>

                    Chỉnh sửa

                </a>

            </div>

        </div>

    </div>

</div>