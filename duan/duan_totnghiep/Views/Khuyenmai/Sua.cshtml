@model duan_totnghiep.Models.Khuyenmai

@{
    Layout = "_Layout";
}

<div class="container py-4">

    <div class="card border-0 shadow-lg rounded-4">

        <div class="card-header bg-warning text-dark py-3">
            <h3 class="mb-0">
                <i class="bi bi-pencil-square"></i>
                Chỉnh sửa khuyến mãi
            </h3>
        </div>

        <div class="card-body p-4">

            <form asp-action="Sua">

                <input type="hidden" asp-for="Makm" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row">

                    <!-- Tên -->
                    <div class="col-md-6 mb-4">

                        <label asp-for="Tenkm"
                               class="form-label fw-semibold">
                            Tên khuyến mãi
                        </label>

                        <input asp-for="Tenkm"
                               class="form-control form-control-lg" />

                        <span asp-validation-for="Tenkm"
                              class="text-danger"></span>

                    </div>

                    <!-- Giảm -->
                    <div class="col-md-6 mb-4">

                        <label asp-for="Phantramgiam"
                               class="form-label fw-semibold">
                            Phần trăm giảm (%)
                        </label>

                        <div class="input-group">

                            <input asp-for="Phantramgiam"
                                   class="form-control form-control-lg" />

                            <span class="input-group-text">%</span>

                        </div>

                        <span asp-validation-for="Phantramgiam"
                              class="text-danger"></span>

                    </div>

                    <!-- Ngày bắt đầu -->
                    <div class="col-md-6 mb-4">

                        <label asp-for="Ngaybatdau"
                               class="form-label fw-semibold">
                            Ngày bắt đầu
                        </label>

                        <input asp-for="Ngaybatdau"
                               type="date"
                               class="form-control form-control-lg" />

                        <span asp-validation-for="Ngaybatdau"
                              class="text-danger"></span>

                    </div>

                    <!-- Ngày kết thúc -->
                    <div class="col-md-6 mb-4">

                        <label asp-for="Ngayketthuc"
                               class="form-label fw-semibold">
                            Ngày kết thúc
                        </label>

                        <input asp-for="Ngayketthuc"
                               type="date"
                               class="form-control form-control-lg" />

                        <span asp-validation-for="Ngayketthuc"
                              class="text-danger"></span>

                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left"></i>
                        Quay lại

                    </a>

                    <button type="submit"
                            class="btn btn-warning">

                        <i class="bi bi-check-circle"></i>
                        Lưu thay đổi

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}