@model duan_totnghiep.Models.Nhanvien

@{
    Layout = "_Layout";
}

<div class="dashboard-header">

    <div>
        <span class="page-tag">
            👨‍💼 Nhân viên
        </span>

        <h2>Chi tiết nhân viên</h2>

        <p>Thông tin và hiệu suất làm việc của nhân viên.</p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i>
        Quay lại
    </a>

</div>

<div class="detail-card">

    <div class="detail-row">
        <span>Mã nhân viên</span>
        <strong>#@Model.Manv</strong>
    </div>

    <div class="detail-row">
        <span>Họ tên</span>
        <strong>@Model.Hoten</strong>
    </div>

    <div class="detail-row">
        <span>Số điện thoại</span>
        <strong>@Model.Sdt</strong>
    </div>

    <div class="detail-row">
        <span>Email</span>
        <strong>@Model.Email</strong>
    </div>

    <div class="detail-row">
        <span>Địa chỉ</span>
        <strong>@Model.Diachi</strong>
    </div>

    <div class="detail-row">
        <span>Chức vụ</span>
        <span class="badge bg-primary">@Model.Chucvu</span>
    </div>

    <div class="detail-row">
        <span>Tài khoản</span>
        <strong>@Model.Taikhoan?.Tendangnhap</strong>
    </div>

    <div class="detail-row">
        <span>Số đơn xử lý</span>
        <span class="badge bg-info">
            @(Model.Donhangs?.Count ?? 0)
        </span>
    </div>

    <div class="detail-row">
        <span>Doanh thu</span>
        <strong class="text-success">
            @((Model.Donhangs?.Sum(x => x.Tongtien) ?? 0).ToString("N0")) VNĐ
        </strong>
    </div>

</div>