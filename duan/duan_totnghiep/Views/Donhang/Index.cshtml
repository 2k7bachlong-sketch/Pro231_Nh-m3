@model IEnumerable<duan_totnghiep.Models.Donhang>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý đơn hàng";
}

<style>
    .action-btn {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: .25s;
    }

        .action-btn:hover {
            transform: translateY(-2px);
        }

    .btn-view {
        background: #EFF6FF;
        color: #2563EB;
    }

        .btn-view:hover {
            background: #2563EB;
            color: white;
        }

    .btn-edit {
        background: #FEF9C3;
        color: #CA8A04;
    }

        .btn-edit:hover {
            background: #EAB308;
            color: white;
        }

    .btn-delete {
        background: #FEE2E2;
        color: #DC2626;
    }

        .btn-delete:hover {
            background: #DC2626;
            color: white;
        }

    .status-select {
        min-width: 145px;
        border-radius: 10px;
        font-weight: 600;
    }
</style>

<!-- Header -->

<div class="dashboard-header">

    <div>

        <span class="page-tag">
            QUẢN LÝ
        </span>

        <h2>

            <i class="bi bi-receipt-cutoff"></i>

            Đơn hàng

        </h2>

        <p>

            Theo dõi và cập nhật trạng thái các đơn hàng.

        </p>

    </div>

    <a asp-action="Lap"
       class="btn-add">

        <i class="bi bi-plus-circle-fill"></i>

        Lập đơn

    </a>

</div>

<!-- Toolbar -->

<div class="toolbar-card">

    <form method="get">

        <div class="row g-3 align-items-center">

            <div class="col-lg-9">

                <div class="search-group">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           name="searchString"
                           class="form-control"
                           value="@Context.Request.Query["searchString"]"
                           placeholder="Nhập mã đơn, khách hàng hoặc nhân viên..." />

                </div>

            </div>

            <div class="col-lg-3">

                <div class="d-flex gap-2">

                    <button class="btn btn-filter flex-grow-1">

                        <i class="bi bi-search"></i>

                        Tìm kiếm

                    </button>

                    <a asp-action="Index"
                       class="btn btn-reset">

                        <i class="bi bi-arrow-clockwise"></i>

                    </a>

                </div>

            </div>

        </div>

    </form>

</div>

<!-- Table -->

<div class="table-card">

    <table class="table table-hover align-middle">

        <thead>

            <tr>

                <th>

                    <i class="bi bi-hash"></i>

                    Mã đơn

                </th>

                <th>

                    <i class="bi bi-person-fill"></i>

                    Khách hàng

                </th>

                <th>

                    <i class="bi bi-person-badge-fill"></i>

                    Nhân viên

                </th>

                <th>

                    <i class="bi bi-calendar-event-fill"></i>

                    Ngày đặt

                </th>

                <th>

                    <i class="bi bi-cash-stack"></i>

                    Tổng tiền

                </th>

                <th>

                    <i class="bi bi-arrow-repeat"></i>

                    Trạng thái

                </th>

                <th width="160">

                    <i class="bi bi-gear-fill"></i>

                    Chức năng

                </th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>

                        <strong>

                            #DH@(item.Madh.ToString("D3"))

                        </strong>

                    </td>

                    <td>

                        @item.Khachhang?.Hoten

                    </td>

                    <td>

                        @item.Nhanvien?.Hoten

                    </td>

                    <td>

                        @item.Ngaydat?.ToString("dd/MM/yyyy")

                    </td>

                    <td>

                        <span class="badge bg-success">

                            @item.Tongtien.ToString("N0") VNĐ

                        </span>

                    </td>

                        <td>

                            <form asp-action="CapNhatTrangThai"
                                  method="post"
                                  class="d-flex">

                                <input type="hidden"
                                       name="id"
                                       value="@item.Madh" />


                                <select name="trangThai"
                                        class="form-select form-select-sm status-select"
                                        onchange="this.form.submit()"
                                    @(item.Trangthai == "Đã hoàn thành" || item.Trangthai == "Đã hủy" ? "disabled" : "")>

                                    @if (item.Trangthai == "Đang xử lý")
                                    {
                                        <option selected>Đang xử lý</option>
                                    }
                                    else
                                    {
                                        <option>Đang xử lý</option>
                                    }

                                    @if (item.Trangthai == "Đang giao")
                                    {
                                        <option selected>Đang giao</option>
                                    }
                                    else
                                    {
                                        <option>Đang giao</option>
                                    }

                                    @if (item.Trangthai == "Đã hoàn thành")
                                    {
                                        <option selected>Đã hoàn thành</option>
                                    }
                                    else
                                    {
                                        <option>Đã hoàn thành</option>
                                    }

                                    @if (item.Trangthai == "Đã hủy")
                                    {
                                        <option selected>Đã hủy</option>
                                    }
                                    else
                                    {
                                        <option>Đã hủy</option>
                                    }

                                </select>

                            </form>

                        </td>

                    <td>

                        <div class="d-flex gap-2">

                            <a asp-action="ChiTiet"
                               asp-route-id="@item.Madh"
                               class="action-btn btn-view">

                                <i class="bi bi-eye-fill"></i>

                            </a>

                            <a asp-action="Sua"
                               asp-route-id="@item.Madh"
                               class="action-btn btn-edit">

                                <i class="bi bi-pencil-fill"></i>

                            </a>

                            <a asp-action="Xoa"
                               asp-route-id="@item.Madh"
                               class="action-btn btn-delete">

                                <i class="bi bi-trash-fill"></i>

                            </a>

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>