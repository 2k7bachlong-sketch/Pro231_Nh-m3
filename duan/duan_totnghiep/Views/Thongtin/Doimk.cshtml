@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_Layout";
}

<style>
    body {
        background: #f5f5f5;
        font-family: "Segoe UI", sans-serif;
    }

    .card {
        width: 600px;
        margin: 50px auto;
        background: white;
        border-radius: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,.08);
        overflow: hidden;
    }

    .card-header {
        background: #111;
        color: white;
        padding: 25px;
        text-align: center;
    }

        .card-header h2 {
            margin: 0;
        }

    .card-body {
        padding: 35px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
    }

    input {
        width: 100%;
        height: 48px;
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 0 15px;
        font-size: 15px;
        transition: .3s;
        box-sizing: border-box;
    }

        input:focus {
            outline: none;
            border-color: #111;
        }

    .btn-group {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }

    .btn-save,
    .btn-back {
        flex: 1;
        height: 50px;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        font-size: 16px;
        text-decoration: none;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: .3s;
    }

    .btn-save {
        background: #111;
        color: white;
    }

        .btn-save:hover {
            background: #333;
        }

    .btn-back {
        background: white;
        color: #111;
        border: 1px solid #111;
    }

        .btn-back:hover {
            background: #111;
            color: white;
        }

    .alert-success {
        background: #d1e7dd;
        color: #0f5132;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .alert-danger {
        background: #f8d7da;
        color: #842029;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    @@media(max-width:700px) {

        .card {
            width: 95%;
        }

        .btn-group {
            flex-direction: column;
        }
    }
</style>

<div class="card">

    <div class="card-header">
        <h2>Đổi mật khẩu</h2>
    </div>

    <div class="card-body">

        @if (ViewBag.Success != null)
        {
            <div class="alert-success">
                @ViewBag.Success
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert-danger">
                @ViewBag.Error
            </div>
        }

        <form asp-action="DoiMK" method="post">

            <div class="form-group">
                <label>Mật khẩu hiện tại</label>
                <input type="password"
                       name="MatKhauCu"
                       required />
            </div>

            <div class="form-group">
                <label>Mật khẩu mới</label>
                <input type="password"
                       name="MatKhauMoi"
                       required />
            </div>

            <div class="form-group">
                <label>Nhập lại mật khẩu mới</label>
                <input type="password"
                       name="NhapLai"
                       required />
            </div>

            <div class="btn-group">

                <button type="submit" class="btn-save">
                    🔒 Đổi mật khẩu
                </button>

                <a asp-action="Index" class="btn-back">
                    ← Quay lại
                </a>

            </div>

        </form>

    </div>

</div>