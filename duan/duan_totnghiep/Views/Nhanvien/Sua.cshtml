@model duan_totnghiep.Models.Nhanvien

@{
    Layout = "_Layout";
}

<div class="form-container">

    <div class="form-header">

        <span class="page-tag">
            👨‍💼 Nhân viên
        </span>

        <h2>Chỉnh sửa nhân viên</h2>

        <p>
            Cập nhật thông tin nhân viên.
        </p>

    </div>

    <form asp-action="Sua" method="post">

        <input asp-for="Manv" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="form-group">

            <label>Họ tên</label>

            <input asp-for="Hoten"
                   class="form-control" />

        </div>

        <div class="form-group">

            <label>Số điện thoại</label>

            <input asp-for="Sdt"
                   class="form-control" />

        </div>

        <div class="form-group">

            <label>Email</label>

            <input asp-for="Email"
                   class="form-control" />

        </div>

        <div class="form-group">

            <label>Địa chỉ</label>

            <input asp-for="Diachi"
                   class="form-control" />

        </div>

        <div class="form-group">

            <label>Tên đăng nhập</label>

            <input name="Tendangnhap"
                   value="@Model.Taikhoan?.Tendangnhap"
                   class="form-control" />

        </div>

        <div class="form-group">

            <label>Mật khẩu</label>

            <input name="Matkhau"
                   value="@Model.Taikhoan?.Matkhau"
                   class="form-control" />

        </div>

        <div class="form-group">

            <label>Chức vụ</label>

            <select asp-for="Chucvu"
                    class="form-select">

                <option value="">-- Chọn chức vụ --</option>

                <option value="Nhân viên">
                    Nhân viên
                </option>

                <option value="Admin">
                   Admin
                </option>

                <option value="Vận chuyển">
                    Vận chuyển
                </option>

            </select>

        </div>

        <div class="mt-4 d-flex gap-2">

            <button class="btn btn-add">

                <i class="bi bi-check-circle-fill"></i>

                Lưu

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>

                Quay lại

            </a>

        </div>

    </form>

</div>