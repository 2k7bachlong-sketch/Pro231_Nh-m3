@model duan_totnghiep.Models.Sanpham

@{
    Layout = "_Layout";
}

<div class="dashboard-header">

    <div>

        <span class="page-tag">
            QUẢN LÝ
        </span>

        <h2>
            <i class="bi bi-bag-plus-fill"></i>
            Thêm sản phẩm
        </h2>

        <p>
            Tạo sản phẩm mới cho cửa hàng.
        </p>

    </div>

</div>

<div class="form-card">

    <div asp-validation-summary="All"
         class="alert alert-danger">
    </div>

    <form asp-action="Them"
          method="post"
          enctype="multipart/form-data">

        <div class="row">

            <div class="col-md-12 mb-3">

                <label class="form-label">
                    Tên sản phẩm
                </label>

                <input asp-for="Tensp"
                       class="form-control" />

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Giá bán
                </label>

                <input asp-for="Gia"
                       class="form-control" />

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Số lượng tồn
                </label>

                <input asp-for="Soluongton"
                       class="form-control" />

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Danh mục
                </label>

                <select asp-for="Madm"
                        asp-items="ViewBag.Madm"
                        class="form-select">
                </select>

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Thương hiệu
                </label>

                <select asp-for="Math"
                        asp-items="ViewBag.Math"
                        class="form-select">
                </select>

            </div>

            <div class="col-md-12 mb-3">

                <label class="form-label">
                    Chương trình khuyến mãi
                </label>

                <select asp-for="Makm"
                        asp-items="ViewBag.Makm"
                        class="form-select">

                    <option value="">
                        -- Không áp dụng --
                    </option>

                </select>

            </div>

            <div class="col-md-12 mb-4">

                <label class="form-label">
                    Hình ảnh sản phẩm
                </label>

                <div class="image-upload-card">

                    <img id="previewImage"
                         src="https://placehold.co/500x300?text=Preview"
                         alt="Preview" />

                    <div class="mt-3">

                        <input type="file"
                               id="imageUpload"
                               name="fileAnh"
                               class="form-control"
                               accept="image/*" />

                    </div>

                    <small id="fileName" class="text-muted mt-2 d-block">
                        Chưa chọn ảnh
                    </small>

                </div>

            </div>

        </div>

        <div class="form-footer">

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>

                Quay lại

            </a>

            <button class="btn btn-add">

                <i class="bi bi-plus-circle-fill"></i>

                Thêm sản phẩm

            </button>

        </div>

    </form>

</div>
<script>

    const upload=document.getElementById("imageUpload");

    const preview=document.getElementById("previewImage");

    const fileName=document.getElementById("fileName");

    upload.addEventListener("change",function(){

        const file=this.files[0];

        if(file){

            fileName.textContent=file.name;

            const reader=new FileReader();

            reader.onload=function(e){

                preview.src=e.target.result;

            }

            reader.readAsDataURL(file);

        }

    });

</script>