        </div>

    </div>

    <div class="section-heading">

        <small>
            <i class="fa-solid fa-chart-line"></i>
            STARPARD
        </small>

        <h2>StarPard trong những con số</h2>

        <p>
            Những con số thể hiện sự phát triển và cam kết của
            <span>StarPard</span>
        </p>

    </div>

    <div class="stats">

        <div class="stat-box">
            <i class="fa-solid fa-shoe-prints"></i>
            <h2>500+</h2>
            <p>Sản phẩm</p>
        </div>

        <div class="stat-box">
            <i class="fa-solid fa-users"></i>
            <h2>2.000+</h2>
            <p>Khách hàng</p>
        </div>

        <div class="stat-box">
            <i class="fa-solid fa-award"></i>
            <h2>100%</h2>
            <p>Chính hãng</p>
        </div>

        <div class="stat-box">
            <i class="fa-solid fa-headset"></i>
            <h2>24/7</h2>
            <p>Hỗ trợ khách hàng</p>
        </div>

    </div>
   
    <script>

            let banners = [
                "/images/banner1.jpg",
                "/images/banner2.jpeg",
                "/images/banner3.jpg"
            ];

            let current = 0;

            setInterval(function () {

                current++;

                if (current >= banners.length) {
                    current = 0;
                }

                document.getElementById("banner-image").src =
                    banners[current];

            }, 3000);

    </script>
</body>
</html>
