@model duan_totnghiep.Models.Sanpham

@{
    Layout = "_Layout";
}

<div class="dashboard-header">

    <div>

        <span class="page-tag">
            THÔNG TIN
        </span>

        <h2>

            <i class="bi bi-box-seam-fill"></i>

            Chi tiết sản phẩm

        </h2>

        <p>
            Xem đầy đủ thông tin sản phẩm.
        </p>

    </div>

</div>

<div class="form-card">

    <div class="row">

        <!-- Ảnh -->

        <div class="col-lg-4 text-center">

            <img src="~/images/@Model.Hinhanh"
                 class="product-detail-img"
                 alt="@Model.Tensp" />

        </div>

        <!-- Thông tin -->

        <div class="col-lg-8">

            <table class="table table-borderless align-middle">

                <tr>

                    <th width="220">
                        Mã sản phẩm
                    </th>

                    <td>
                        #@Model.Masp
                    </td>

                </tr>

                <tr>

                    <th>
                        Tên sản phẩm
                    </th>

                    <td class="fw-semibold">

                        @Model.Tensp

                    </td>

                </tr>

                <tr>

                    <th>
                        Giá bán
                    </th>

                    <td class="text-primary fw-bold fs-5">

                        @String.Format("{0:N0} VNĐ", Model.Gia)

                    </td>

                </tr>

                <tr>

                    <th>
                        Số lượng tồn
                    </th>

                    <td>

                        @Model.Soluongton

                    </td>

                </tr>

                <tr>

                    <th>
                        Danh mục
                    </th>

                    <td>

                        <span class="badge bg-primary">

                            @Model.Danhmuc?.Tendm

                        </span>

                    </td>

                </tr>

                <tr>

                    <th>
                        Thương hiệu
                    </th>

                    <td>

                        <span class="badge bg-dark">

                            @Model.Thuonghieu?.Tenth

                        </span>

                    </td>

                </tr>

                <tr>

                    <th>
                        Khuyến mãi
                    </th>

                    <td>

                        @if (Model.Khuyenmai == null)
                        {
                            <span class="badge bg-secondary">

                                Không áp dụng

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">

                                @Model.Khuyenmai.Tenkm
                                (-@Model.Khuyenmai.Phantramgiam%)

                            </span>
                        }

                    </td>

                </tr>

            </table>

            <div class="form-footer">

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Quay lại

                </a>

                <a asp-action="Sua"
                   asp-route-id="@Model.Masp"
                   class="btn btn-warning">

                    <i class="bi bi-pencil-fill"></i>

                    Chỉnh sửa

                </a>

            </div>

        </div>

    </div>

</div>