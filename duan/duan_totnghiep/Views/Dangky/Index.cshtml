@model duan_totnghiep.Models.Taikhoan
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Đăng ký</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #eee;
            font-family: Arial;
        }

        .header {
            width: 92%;
            height: 90px;
            margin: 20px auto 12px;
            background: grey;
            border-radius: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 35px;
            box-shadow: 0 15px 40px rgba(0,0,0,.18);
        }

        .logo {
            width: 90px;
            transition: .3s;
        }

            .logo:hover {
                transform: scale(1.08);
            }
        .search-box {
            width: 100%;
            display: flex;
            justify-content: center;
        }

            .search-box input {
                width: 650px;
                height: 50px;
                border-radius: 30px;
                border: 1px solid black;
                padding-left: 20px;
            }

        .container {
            width: 1400px;
            max-width: 95%;
            margin: 50px auto;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 90px;
        }

        .left {
            width: 520px; /* bỏ flex:1 */
            flex: none;
            text-align: center;
        }

            .left img {
                width: 330px;
                margin-bottom: 20px;
            }

            .left h1 {
                font-size: 58px;
                margin-bottom: 15px;
                font-weight: 800;
            }

            .left p {
                font-size: 26px;
                color: #666;
                margin-bottom: 50px;
            }

        .feature {
            display: flex;
            align-items: center;
            margin: 25px 0;
        }

        .feature-icon {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 5px 20px rgba(0,0,0,.08);
            display: flex;
            justify-content: center;
            align-items: center;
            color: #ff4040;
            font-size: 28px;
            margin-right: 22px;
        }

        .feature h3 {
            font-size: 34px;
        }

        .feature span {
            color: #777;
            font-size: 20px;
        }

        .register-box {
            width: 500px;
            background: #fff;
            padding: 45px;
            border-radius: 28px;
            box-shadow: 0 20px 45px rgba(0,0,0,.12);
        }

        .title {
            font-size: 58px;
            font-weight: 800;
            text-align: center;
            margin-bottom: 10px;
        }

            .title::after {
                content: "";
                display: block;
                width: 80px;
                height: 4px;
                background: #ff3b3b;
                margin: 18px auto 35px;
                border-radius: 50px;
            }

        .form-group {
            margin-bottom: 18px;
        }

            .form-group input {
                width: 100%;
                height: 58px;
                border: 1px solid #ddd;
                border-radius: 15px;
                padding-left: 18px;
                font-size: 18px;
                transition: .3s;
            }

                .form-group input:focus {
                    border-color: #ff4040;
                    outline: none;
                    box-shadow: 0 0 10px rgba(255,64,64,.15);
                }

        .btnDangKy {
            width: 100%;
            height: 60px;
            border: none;
            border-radius: 15px;
            background: #111;
            color: white;
            font-size: 22px;
            font-weight: bold;
            margin-top: 10px;
            transition: .3s;
        }

            .btnDangKy:hover {
                background: #ff4040;
            }

        .login-link {
            text-align: center;
            margin-top: 25px;
            font-size: 18px;
        }

            .login-link a {
                color: #ff4040;
                text-decoration: none;
                font-weight: bold;
            }

        .back-home {
            margin-top: 15px;
            text-align: center;
        }

            .back-home a {
                text-decoration: none;
                color: #666;
            }

                .back-home a:hover {
                    color: #ff4040;
                }
        
        .error-box {
            width: 100%;
            padding: 16px 20px;
            margin: 20px 0;
            background: #ffe8e8;
            color: #d80027;
            border: 1px solid #ffb7b7;
            border-radius: 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 18px;
            font-weight: 500;
            animation: fadeDown .35s ease;
        }

            .error-box i {
                font-size: 22px;
                color: #ff3b3b;
            }


    </style>
</head>

<body>
    <div class="header">

        <a href="/Giaodien/Index">
            <img src="/images/starlogo.png" class="logo">
        </a>

        <div class="search-box">
            <input type="text" placeholder="Tìm kiếm..." />
        </div>

    </div>

    <div class="container">

        <div class="left">

            <a href="/Giaodien/Index">
                <img src="/images/starlogo.png" class="logo">
            </a>

            <h1>StarPard Shop</h1>

            <p>Shop bán giày uy tín chính hãng hàng đầu Việt Nam</p>

            <div class="feature">
                <div class="feature-icon">🛡️</div>

                <div>
                    <h3>100% Chính hãng</h3>
                    <span>Cam kết chất lượng</span>
                </div>
            </div>

            <div class="feature">
                <div class="feature-icon">🚚</div>

                <div>
                    <h3>Giao hàng toàn quốc</h3>
                    <span>Miễn phí đơn từ 500K</span>
                </div>
            </div>

            <div class="feature">
                <div class="feature-icon">🔄</div>

                <div>
                    <h3>Đổi trả 7 ngày</h3>
                    <span>Hoàn tiền nếu lỗi</span>
                </div>
            </div>

        </div>

        <div class="register-box">

            <h2 class="title">Đăng ký</h2>

            @if (ViewBag.Loi != null)
{
    <div class="error-box">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@ViewBag.Loi</span>
    </div>
}

            <form asp-action="DangKy" method="post">

                <div class="form-group">
                    <input type="text"
                           name="TenDangNhap"
                           placeholder="Tên đăng tài khoản" />
                </div>

                <div class="form-group">
                    <input type="text"
                           name="SoDienThoai"
                           placeholder="SĐT" />
                </div>
                <div class="form-group">
                    <input type="email"
                           name="Email"
                           placeholder="Email"
                           required />
                </div>

                <div class="form-group">
                    <input type="password"
                           name="MatKhau"
                           placeholder="Mật khẩu" />
                </div>
                <div class="form-group">
                    <input type="password"
                           name="NhapLaiMatKhau"
                           placeholder="Nhập lại mật khẩu" />
                </div>

                <button type="submit" class="btnDangKy">
                    Đăng ký
                </button>

                <div class="login-link">
                    Đã có tài khoản?
                    <a href="/Taikhoan/Index">
                        Đăng nhập ngay
                    </a>
                </div>

                <div class="back-home">
                    <a href="/Giaodien/Index">
                        ← Quay về trang chủ
                    </a>
                </div>

            </form>

        </div>

    </div>

</body>
</html>
