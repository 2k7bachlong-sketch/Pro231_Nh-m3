@model duan_totnghiep.Models.Thuonghieu

@{
    Layout = "_Layout";
}

<div class="form-card">

    <div class="form-header">

        <h2>

            <i class="bi bi-pencil-square"></i>

            Cập nhật thương hiệu

        </h2>

        <p>Chỉnh sửa thông tin thương hiệu.</p>

    </div>

    <form asp-action="Sua">

        <input type="hidden" asp-for="Math" />

        <div class="mb-3">

            <label class="form-label">
                Tên thương hiệu
            </label>

            <input asp-for="Tenth"
                   class="form-control" />

        </div>

        <div class="mb-4">

            <label class="form-label">
                Mô tả
            </label>

            <textarea asp-for="Mota"
                      rows="4"
                      class="form-control"></textarea>

        </div>

        <div class="d-flex gap-2">

            <button class="btn btn-warning">

                <i class="bi bi-floppy-fill"></i>

                Cập nhật

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>

                Quay lại

            </a>

        </div>

    </form>

</div>