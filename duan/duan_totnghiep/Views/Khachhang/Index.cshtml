@model IEnumerable<duan_totnghiep.Models.Khachhang>

@{
    Layout = "_Layout";
}

<div class="crud-header">

    <div>

        <span class="page-tag">
            👤 Khách hàng
        </span>

        <h2>Quản lý khách hàng</h2>

        <p>
            Danh sách khách hàng đã đăng ký và khách mua trực tiếp.
        </p>

    </div>

</div>

    <table class="crud-table">

        <thead>
            <tr>
                <th>Mã KH</th>
                <th>Họ tên</th>
                <th>SĐT</th>
                <th>Email</th>
                <th>Địa chỉ</th>
                <th>Loại</th>
                <th>Đơn hàng</th>
                <th width="250">Chức năng</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Makh</td>

                    <td>@item.Hoten</td>

                    <td>@item.Sdt</td>

                    <td>@item.Email</td>

                    <td>@item.Diachi</td>
                <td>

                    @if (item.Matk == null)
                    {
                        <span class="badge bg-secondary">
                            Khách vãng lai
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Thành viên
                        </span>
                    }
                    <td>

                        @(item.Donhangs?.Count ?? 0)

                    </td>

                </td>

                    <td>

                        <a asp-action="ChiTiet"
                           asp-route-id="@item.Makh"
                           class="btn btn-detail">
                            Chi tiết
                        </a>

                        <a asp-action="Sua"
                           asp-route-id="@item.Makh"
                           class="btn btn-edit">
                            Sửa
                        </a>

                       <a asp-action="Xoa"
                           asp-route-Makh="@item.Makh"
                           class="btn btn-delete">
                            Xóa
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>
