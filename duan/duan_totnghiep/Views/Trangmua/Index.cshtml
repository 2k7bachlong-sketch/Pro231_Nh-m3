@model List<duan_totnghiep.Models.Sanpham>

@{
    ViewData["Title"] = "Trang mua hàng";
    Layout = "_LayoutAdmin";
}
<!DOCTYPE html>
<html>
<head>
   
    <meta charset="utf-8" />
    <title>StarPard Shop</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #f5f5f5;
            font-family: Arial, sans-serif;
        }

        /* ================= HEADER ================= */

        .header {
            width: 92%;
            margin: 18px auto 25px;
            background: #fff;
            border-radius: 22px;
            height: 140px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 35px;
            box-shadow: 0 10px 25px rgba(0,0,0,.08);
        }

        .logo img {
            width: 95px;
        }

        .search-box {
            width: 55%;
        }

            .search-box form {
                display: flex;
                align-items: center;
                background: white;
                border: 2px solid #ddd;
                border-radius: 40px;
                overflow: hidden;
                height: 60px;
            }

            .search-box button {
                width: 70px;
                border: none;
                background: white;
                font-size: 22px;
                color: #555;
            }

            .search-box input {
                flex: 1;
                border: none;
                outline: none;
                padding-left: 20px;
                font-size: 24px;
            }

        .right-menu {
            display: flex;
            gap: 12px;
            align-items: center;
        }

            .right-menu a {
                text-decoration: none;
                padding: 10px 18px;
                border-radius: 30px;
                font-size: 18px;
                font-weight: 600;
                transition: .3s;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .right-menu i {
                font-size: 18px;
            }   
        .btn-contact {
            background: white;
            color: #111;
            border: 2px solid #ddd;
        }

        .btn-cart {
            background: #111;
            color: white;
        }

        .btn-logout {
            background: #ef4444;
            color: white;
        }

        .right-menu a:hover {
            transform: translateY(-3px);
        }

        /* DANH MỤC */

        .category {
            width: 92%;
            margin: auto;
            height: 65px;
            background: #111;
            border-radius: 18px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 70px;
            box-shadow: 0 8px 20px rgba(0,0,0,.15);
        }

            .category a {
                color: white;
                text-decoration: none;
                font-size: 17px;
                font-weight: 600;
                padding: 12px 22px;
                border-radius: 30px;
                transition: .3s;
            }

                .category a:hover {
                    background: #E63946;
                }
        /* BANNER */

        .banner {
            width: 100%;
            display: flex;
            justify-content: center;
            margin: 30px 0;
        }

            .banner img {
                width: 92%;
                max-width: 1400px;
                height: 430px;
                object-fit: cover;
                border-radius: 25px;
                transition: .4s;
            }

.banner img:hover{
    transform: scale(1.02);
}
        /* SẢN PHẨM */

        .products {
            margin-top: 50px;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 60px;
        }

        .card {
            width: 220px;
            min-height: 330px;
            background: white;
            border: 5px solid black;
            border-radius: 20px;
            text-align: center;
            padding: 15px;
            transition: all 0.3s ease;
        }

            .card:hover {
                transform: translateY(-12px);
                box-shadow: 0 15px 25px rgba(0,0,0,0.3);
            }

            .card img {
                width: 120px;
                height: 120px;
                object-fit: cover;
            }

            .card h3 {
                margin-top: 10px;
                font-size: 15px;
            }

        .price {
            margin-top: 20px;
            font-size: 22px;
        }

        .btn-giohang {
            display: inline-block;
            margin-top: 15px;
            padding: 10px 15px;
            background: green;
            color: white;
            text-decoration: none;
            border-radius: 8px;
        }

            .btn-giohang:hover {
                background: darkgreen;
            }

.toast{
    position:fixed;
    top:20px;
    right:20px;

    background:#28a745;
    color:white;

    padding:15px 25px;

    border-radius:10px;

    font-weight:bold;

    box-shadow:0 5px 15px rgba(0,0,0,.3);

    z-index:9999;

    animation:fadein .5s;
}

        /* ======= TITLE ======= */

        .section-title {
            width: 100%;
            margin: 40px auto 25px;
            display: flex;
            align-items: center;
            gap: 20px;
        }

            .section-title::before,
            .section-title::after {
                content: "";
                flex: 1;
                height: 2px;
                background: #ddd;
            }

            .section-title h2 {
                color: #111;
                font-size: 34px;
                font-weight: bold;
            }

            .section-title span {
                color: #E63946;
            }

        /* ======= SERVICE ======= */

        .service {
            width: 92%;
            margin: 70px auto;
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 25px;
        }

        .service-box {
            background: white;
            border-radius: 18px;
            padding: 30px;
            text-align: center;
            box-shadow: 0 8px 20px rgba(0,0,0,.08);
            transition: .3s;
        }

            .service-box:hover {
                transform: translateY(-8px);
            }

            .service-box i {
                font-size: 45px;
                color: #E63946;
                margin-bottom: 15px;
            }

            .service-box h3 {
                margin-bottom: 10px;
            }

            .service-box p {
                color: #666;
                font-size: 15px;
            }

        /* ======= SALE ======= */

        .sale-banner {
            width: 92%;
            margin: 35px auto;
            background: linear-gradient(90deg,#111,#E63946);
            border-radius: 22px;
            padding: 35px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
        }

            .sale-banner h2 {
                font-size: 40px;
            }

            .sale-banner p {
                margin-top: 10px;
                font-size: 18px;
            }

            .sale-banner a {
                text-decoration: none;
                color: white;
                background: white;
                color: #111;
                padding: 14px 28px;
                border-radius: 35px;
                font-weight: bold;
            }

        /* ===== CAM KẾT ===== */

        .service-title {
            width: 100%;
            margin: 70px auto 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
        }

            .service-title::before,
            .service-title::after {
                content: "";
                flex: 1;
                height: 2px;
                background: #ddd;
            }

        .service-text {
            text-align: center;
        }

            .service-text h2 {
                font-size: 36px;
                color: #111;
                margin-bottom: 8px;
            }

                .service-text h2 span {
                    color: #E63946;
                }

            .service-text p {
                color: #666;
                font-size: 17px;
            }
    </style>
</head>
<body>

    @* Thêm SP vào giỏ *@
    @if (TempData["Success"] != null)
    {
        <div class="toast" id="toast">
            ✔ @TempData["Success"]
        </div>

        <script>
                setTimeout(function(){
                    document.getElementById("toast").style.display="none";
                },2500);
        </script>
    }

    <!-- HEADER -->

    <div class="header">
        <div class="logo">
            <a asp-controller="Trangmua" asp-action="Index">
                <img src="~/images/starlogo.png" alt="Logo">
            </a>
        </div>

        <div class="search-box">

            <form asp-controller="Trangmua"
                  asp-action="Index"
                  method="get">

                <button type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>

                <input type="text"
                       name="searchString"
                       placeholder="Tìm kiếm sản phẩm..." />

            </form>

        </div>

        <div class="right-menu">

            <a href="#" class="btn-contact">
                <i class="fa-solid fa-phone"></i>
                Liên hệ
            </a>

            <a asp-controller="Giohang"
               asp-action="Index"
               class="btn-cart">

                <i class="fa-solid fa-cart-shopping"></i>
                Giỏ hàng

            </a>

            <a asp-controller="Giaodien"
               asp-action="Index"
               class="btn-logout">

                <i class="fa-solid fa-right-from-bracket"></i>
                Đăng xuất

            </a>

        </div>

    </div>

    <!-- DANH MỤC -->


    <div class="category">

        <a asp-controller="Danhmuc"
           asp-action="List"
           asp-route-id="1"
           asp-route-returnController="Trangmua">
            <i class="fa-solid fa-person-running"></i>
            Giày thể thao
        </a>

        <a asp-controller="Danhmuc"
           asp-action="List"
           asp-route-id="2"
           asp-route-returnController="Trangmua">
            <i class="fa-solid fa-shop"></i>
            Giày da
        </a>

        <a asp-controller="Danhmuc"
           asp-action="List"
           asp-route-id="3"
           asp-route-returnController="Trangmua">
            <i class="fa-solid fa-person-dress"></i>
            Giày cao gót
        </a>

        <a href="#">
            <i class="fa-solid fa-fire"></i>
            Khuyến mãi
        </a>

    </div>
    <!-- BANNER -->
    <div class="banner">
        <img id="banner-image"
             src="/images/banner1.jpg"
             alt="Banner">     
    </div>

    <div class="sale-banner">

        <div>
            <h2>🔥 SIÊU SALE</h2>
            <p>Giảm đến 50% tất cả giày thể thao</p>
        </div>

        <a href="#">Mua ngay</a>

    </div>

    <div class="section-title">
        <h2><span>SẢN PHẨM</span> NỔI BẬT</h2>
    </div>

    <!-- SẢN PHẨM -->

    <div class="products">

        @foreach (var item in Model)
        {
            <div class="card">

                <img src="~/images/@item.Hinhanh" />

                <h3>@item.Tensp</h3>

                <div class="price">
                    @String.Format("{0:N0} đ", item.Gia)
                </div>

                <a asp-controller="Giohang"
                   asp-action="ThemVaoGio"
                   asp-route-id="@item.Masp"
                   class="btn-giohang">
                    Thêm vào giỏ hàng
                </a>

            </div>
        }

    </div>

    <div class="service-title">

        <div class="service-text">
            <h2><span>UY TÍN</span> • CHẤT LƯỢNG</h2>
            <p>Cam kết mang đến những sản phẩm chính hãng với dịch vụ tốt nhất.</p>
        </div>

    </div>

    <div class="service">

        <div class="service-box">
            <i class="fa-solid fa-truck-fast"></i>
            <h3>Miễn phí vận chuyển</h3>
            <p>Đơn hàng từ 500.000đ</p>
        </div>

        <div class="service-box">
            <i class="fa-solid fa-shield-halved"></i>
            <h3>Chính hãng 100%</h3>
            <p>Cam kết hàng chất lượng</p>
        </div>

        <div class="service-box">
            <i class="fa-solid fa-rotate-left"></i>
            <h3>Đổi trả 7 ngày</h3>
            <p>Đổi nếu có lỗi từ nhà sản xuất</p>
        </div>

        <div class="service-box">
            <i class="fa-solid fa-headset"></i>
            <h3>Hỗ trợ 24/7</h3>
            <p>Luôn sẵn sàng tư vấn khách hàng</p>
        </div>


    <script>

        let banners = [
            "/images/banner1.jpg",
            "/images/banner2.jpeg",
            "/images/banner3.jpg"
        ];

        let current = 0;

        setInterval(function () {

            current++;

            if (current >= banners.length) {
                current = 0;
            }

            document.getElementById("banner-image").src =
                banners[current];

        }, 3000);

    </script>
</body>
</html>