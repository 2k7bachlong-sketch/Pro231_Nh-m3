@model duan_totnghiep.Models.Nhanvien

@{
    Layout = "_Layout";
}

<div class="delete-container">

    <h2>Xóa nhân viên</h2>

    <hr />

    <p><strong>Mã:</strong> @Model.Manv</p>

    <p><strong>Họ tên:</strong> @Model.Hoten</p>

    <p><strong>SĐT:</strong> @Model.Sdt</p>

    <p><strong>Email:</strong> @Model.Email</p>

    <p><strong>Tài khoản:</strong> @Model.Taikhoan?.Tendangnhap</p>

    @if (Model.Donhangs.Any())
    {
        <div class="alert alert-warning">

            Nhân viên này đã xử lý đơn hàng nên không thể xóa.

        </div>
    }

    <form asp-action="Xoa"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="id"
               value="@Model.Manv" />

        <button class="btn btn-delete"
            @(Model.Donhangs.Any() ? "disabled" : "")>

            Xóa

        </button>

        <a asp-action="Index"
           class="btn btn-cancel">

            Hủy

        </a>

    </form>

</div>