                    }

                    <div class="price">
                        <span class="old-price">
                            @String.Format("{0:N0} đ", item.Gia)
                        </span>
                        <br />
                        <span class="new-price">
                            @String.Format("{0:N0} đ", giaMoi)
                        </span>
                    </div>

                    <div class="product-buttons">

                        <a asp-controller="Trangmua"
                           asp-action="ChiTiet"
                           asp-route-id="@item.Masp"
                           class="btn-detail">
                            Xem chi tiết
                        </a>

                        @if (item.Soluongton > 0)
                        {
                           
                                   <a asp-controller="Giohang"
           asp-action="ThemVaoGio"
           asp-route-id="@item.Masp"
           asp-route-size="40"
           class="btn-giohang">
            Thêm vào giỏ
        </a>
                            
                        }
                        else
                        {
                            <button class="btn-giohang out-stock" disabled>
                                Đã hết hàng
                            </button>
                        }

                    </div>
                </div>
            }
        </div>

    </div>

    <div class="service-title">

        <div class="service-text">
            <h2><span>UY TÍN</span> • CHẤT LƯỢNG</h2>
            <p>Cam kết mang đến những sản phẩm chính hãng với dịch vụ tốt nhất.</p>
        </div>

    </div>

    <div class="service">

        <div class="service-box">
            <i class="fa-solid fa-truck-fast"></i>
            <h3>Miễn phí vận chuyển</h3>
            <p>Đơn hàng từ 500.000đ</p>
        </div>

        <div class="service-box">
            <i class="fa-solid fa-shield-halved"></i>
            <h3>Chính hãng 100%</h3>
            <p>Cam kết hàng chất lượng</p>
        </div>

        <div class="service-box">
            <i class="fa-solid fa-rotate-left"></i>
            <h3>Đổi trả 7 ngày</h3>
            <p>Đổi nếu có lỗi từ nhà sản xuất</p>
        </div>

        <div class="service-box">
            <i class="fa-solid fa-headset"></i>
            <h3>Hỗ trợ 24/7</h3>
            <p>Luôn sẵn sàng tư vấn khách hàng</p>
        </div>

        <!--Popup thêm vào giỏ hàng-->
        <div id="sizePopup" class="popup">

            <div class="popup-content product-popup">

                <img id="popupImg">

                <h2 id="popupName"></h2>

                <p id="popupPrice"></p>

                <p id="popupStock"></p>

                <h3>Chọn Size</h3>

                <div class="size-list">
                    <button class="size-btn">38</button>
                    <button class="size-btn">39</button>
                    <button class="size-btn">40</button>
                    <button class="size-btn">41</button>
                    <button class="size-btn">42</button>
                </div>

                <button id="btnAddCart">
                    Thêm vào giỏ
                </button>

            </div>

        </div>
    </div>

    <script>

        let banners = [
            "/images/banner1.jpg",
            "/images/banner2.jpeg",
            "/images/banner3.jpg"
        ];

        let current = 0;

        setInterval(function () {

            current++;

            if (current >= banners.length) {
                current = 0;
            }

            document.getElementById("banner-image").src =
                banners[current];

        }, 3000);

        </script>
        <script>
                     document.getElementById("btnSale").addEventListener("click", function (e) {

                         e.preventDefault();

                         const target = document.getElementById("sale-products");
                         const targetY = target.getBoundingClientRect().top + window.pageYOffset - 20;

                         const startY = window.pageYOffset;
                         const distance = targetY - startY;
                         const duration = 1800; // tăng lên 2500 nếu muốn chậm hơn

                         let startTime = null;

                         function animation(currentTime) {
                             if (!startTime) startTime = currentTime;

                             const timeElapsed = currentTime - startTime;
                             const progress = Math.min(timeElapsed / duration, 1);

                             // Ease in-out
                             const ease = progress < 0.5
                                 ? 2 * progress * progress
                                 : 1 - Math.pow(-2 * progress + 2, 2) / 2;

                             window.scrollTo(0, startY + distance * ease);

                             if (timeElapsed < duration) {
                                 requestAnimationFrame(animation);
                             } else {
                                 target.classList.add("sale-highlight");

                                 setTimeout(() => {
                                     target.classList.remove("sale-highlight");
                                 }, 1000);
                             }
                         }

                         requestAnimationFrame(animation);
                     });
        </script>

        <script>

            const btn = document.getElementById("btnNotify");
            const panel = document.getElementById("notifyPanel");
            const list = document.getElementById("notifyList");
            const count = document.getElementById("notifyCount");

            btn.onclick = function () {

                panel.style.display =
                    panel.style.display == "block"
                        ? "none"
                        : "block";

            };

            document.addEventListener("click", function (e) {

                if (!document.querySelector(".notify-area").contains(e.target)) {
                    panel.style.display = "none";
                }

            });
        </script>

   
</body>
</html>