<div class="dashboard-header">

    <div>

        <span class="page-tag">
            QUẢN LÝ
        </span>

        <h2>🎁 Khuyến mãi</h2>

        <p>
            Theo dõi các chương trình giảm giá của cửa hàng.
        </p>

    </div>

    <a asp-action="Them" class="btn-add">

        <i class="bi bi-plus-circle-fill"></i>

        Thêm khuyến mãi

    </a>

</div>


@* DashBoard *@
<div class="row mb-4">

    <div class="col-md-4">

        <div class="stat-card">

            <div>

                <small>Tổng khuyến mãi</small>

                <h3>@Model.Count()</h3>

            </div>

            <i class="bi bi-ticket-perforated-fill"></i>

        </div>

    </div>

    <div class="col-md-4">

        <div class="stat-card success">

            <div>

                <small>Đang hoạt động</small>

                @Model.Count(x => x.TrangThaiHienThi == "Hoạt động")
                                

            </div>

            <i class="bi bi-check-circle-fill"></i>

        </div>

    </div>

    <div class="col-md-4">

        <div class="stat-card danger">

            <div>

                <small>Đã kết thúc</small>

                <h3>@Model.Count(x => x.TrangThaiHienThi == "Đã kết thúc")</h3>

            </div>

            <i class="bi bi-x-circle-fill"></i>

        </div>

    </div>

</div>


<div class="toolbar-card">

    <form method="get" asp-action="Index">

        <div class="row g-3 align-items-center">

            <!-- Search -->
            <div class="col-lg-6">

                <div class="search-group">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           name="searchString"
                           class="form-control"
                           value="@Context.Request.Query["searchString"]"
                           placeholder="Tìm kiếm tên hoặc mã khuyến mãi..." />

                </div>

            </div>

            <!-- Filter -->
            <div class="col-lg-3">

                <select name="status" class="form-select">

                    <option value="">Tất cả trạng thái</option>

                    <option value="Hoạt động"
                            selected="@(Context.Request.Query["status"] == "Hoạt động")">
                        Hoạt động
                    </option>

                    <option value="Đã kết thúc"
                            selected="@(Context.Request.Query["status"] == "Đã kết thúc")">
                        Đã kết thúc
                    </option>

                    <option value="Sắp diễn ra"
                            selected="@(Context.Request.Query["status"] == "Sắp diễn ra")">
                        Sắp diễn ra
                    </option>

                </select>

            </div>

            <!-- Button -->

            <div class="col-lg-3">

                <div class="d-flex gap-2">

                    <button class="btn btn-filter flex-grow-1">

                        <i class="bi bi-funnel-fill"></i>

                        Lọc

                    </button>

                    <a asp-action="Index" class="btn btn-reset">

                        <i class="bi bi-arrow-clockwise"></i>

                    </a>

                </div>

            </div>

        </div>

    </form>

</div>
<table class="table table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Mã KM</th>
            <th>Tên</th>
            <th>Giảm %</th>
            <th>Bắt đầu</th>
            <th>Kết thúc</th>
            <th>Trạng thái</th>
            <th>Chức năng</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Makm</td>
                <td>@item.Tenkm</td>
                <td>@item.Phantramgiam%</td>
                <td>@item.Ngaybatdau?.ToString("dd/MM/yyyy")</td>
                <td>@item.Ngayketthuc?.ToString("dd/MM/yyyy")</td>
                <td>

                    @if (item.TrangThaiHienThi == "Hoạt động")
                    {
                        <span class="badge bg-success">
                            🟢 Hoạt động
                        </span>
                    }
                    else if (item.TrangThaiHienThi == "Sắp diễn ra")
                    {
                        <span class="badge bg-warning text-dark">
                            🟡 Sắp diễn ra
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            🔴 Đã kết thúc
                        </span>
                    }

                </td>
                <td>
                    <a asp-action="ChiTiet" asp-route-id="@item.Makm" class="btn btn-sm btn-primary">Chi tiết</a>
                    <a asp-action="Sua" asp-route-id="@item.Makm" class="btn btn-sm btn-warning">Sửa</a>
                    <button class="btn btn-sm btn-danger btnDelete"
                            data-id="@item.Makm"
                            data-name="@item.Tenkm">

                        <i class="bi bi-trash3"></i>

                        Xóa

                    </button>
                </td>
            </tr>
        }
    </tbody>
    <div class="modal fade"
         id="deleteModal"
         tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content rounded-4">

                <div class="modal-header bg-danger text-white">

                    <h5 class="modal-title">

                        <i class="bi bi-trash3-fill"></i>

                        Xác nhận xóa

                    </h5>

                    <button class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>

                </div>

                <div class="modal-body">

                    <div class="text-center">

                        <i class="bi bi-exclamation-triangle-fill
                        text-warning"
                           style="font-size:55px;"></i>

                        <h5 class="mt-3">

                            Bạn có chắc muốn xóa?

                        </h5>

                        <p>

                            Khuyến mãi

                            <strong id="deleteName"></strong>

                        </p>

                        <small class="text-danger">

                            Hành động này không thể hoàn tác.

                        </small>

                    </div>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Hủy

                    </button>

                    <form id="deleteForm"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button class="btn btn-danger">

                            <i class="bi bi-trash3-fill"></i>

                            Xóa

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</table>
<script>
    document.querySelector("select[name='status']")
        .addEventListener("change", function () {
            this.form.submit();
        });
</script>
<script>

    document.querySelectorAll(".btnDelete").forEach(btn=>{

        btn.addEventListener("click",function(){

            let id=this.dataset.id;

            let name=this.dataset.name;

            document.getElementById("deleteName").innerText=name;

            document.getElementById("deleteForm").action="/Khuyenmai/Xoa/"+id;

            new bootstrap.Modal(document.getElementById("deleteModal")).show();

        });

    });

</script>
