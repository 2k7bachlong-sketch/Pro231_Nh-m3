@model IEnumerable<duan_totnghiep.Models.Khachhang>

@{
    Layout = "_Layout";
}

<style>
    .action-btn {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: .25s;
    }

        .action-btn:hover {
            transform: translateY(-2px);
        }

    .btn-view {
        background: #EFF6FF;
        color: #2563EB;
    }

        .btn-view:hover {
            background: #2563EB;
            color: white;
        }

    .btn-edit {
        background: #FEF9C3;
        color: #CA8A04;
    }

        .btn-edit:hover {
            background: #EAB308;
            color: white;
        }

    .btn-delete {
        background: #FEE2E2;
        color: #DC2626;
    }

        .btn-delete:hover {
            background: #DC2626;
            color: white;
        }

    .btn-warning {
        background: #FEF3C7;
        color: #D97706;
        border: none;
    }

        .btn-warning:hover {
            background: #D97706;
            color: white;
        }

    .btn-success {
        background: #DCFCE7;
        color: #16A34A;
        border: none;
    }

        .btn-success:hover {
            background: #16A34A;
            color: white;
        }
</style>

<!-- Header -->

<div class="dashboard-header">

    <div>

        <span class="page-tag">
            QUẢN LÝ
        </span>

        <h2>
            <i class="bi bi-people-fill"></i>
            Khách hàng
        </h2>

        <p>
            Quản lý toàn bộ khách hàng của cửa hàng.
        </p>

    </div>

</div>

<!-- Toolbar -->

<div class="toolbar-card">

    <form method="get">

        <div class="row g-3 align-items-center">

            <div class="col-lg-9">

                <div class="search-group">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           name="searchString"
                           class="form-control"
                           value="@Context.Request.Query["searchString"]"
                           placeholder="Nhập tên, số điện thoại hoặc email..." />

                </div>

            </div>

            <div class="col-lg-3">

                <div class="d-flex gap-2">

                    <button class="btn btn-filter flex-grow-1">

                        <i class="bi bi-search"></i>

                        Tìm kiếm

                    </button>

                    <a asp-action="Index"
                       class="btn btn-reset">

                        <i class="bi bi-arrow-clockwise"></i>

                    </a>

                </div>

            </div>

        </div>

    </form>

</div>

<!-- Table -->

<div class="table-card">

    <table class="table align-middle table-hover">

        <thead>

            <tr>

                <th>
                    <i class="bi bi-person-fill"></i>
                    Khách hàng
                </th>

                <th>
                    <i class="bi bi-telephone-fill"></i>
                    SĐT
                </th>

                <th>
                    <i class="bi bi-envelope-fill"></i>
                    Email
                </th>

                <th>
                    <i class="bi bi-geo-alt-fill"></i>
                    Địa chỉ
                </th>

                <th>
                    <i class="bi bi-person-badge-fill"></i>
                    Loại
                </th>

                <th>
                    <i class="bi bi-bag-check-fill"></i>
                    Đơn hàng
                </th>

                <th width="160">
                    <i class="bi bi-gear-fill"></i>
                    Chức năng
                </th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>

                        <div>

                            <div class="fw-bold">

                                @item.Hoten

                            </div>

                            <small class="text-muted">

                                #KH@(item.Makh)

                            </small>

                        </div>

                    </td>

                    <td>

                        @item.Sdt

                    </td>

                    <td>

                        @item.Email

                    </td>

                    <td>

                        @item.Diachi

                    </td>

                    <td>

                        @if (item.Matk == null)
                        {
                            <span class="badge bg-secondary">

                                Khách vãng lai

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">

                                Thành viên

                            </span>
                        }

                    </td>


                    <td>

                        <span class="badge bg-primary">

                            @(item.Donhangs?.Count ?? 0)

                        </span>

                    </td>

                    <td>

                        <div class="d-flex gap-2">

                            @if (item.Hoten == "Khách vãng lai")
                            {
                                <div class="d-flex">

                                    <a asp-action="ChiTiet"
                                       asp-route-id="@item.Makh"
                                       class="action-btn btn-view">

                                        <i class="bi bi-eye-fill"></i>

                                    </a>

                                </div>
                            }
                            else
                            {
                                <div class="d-flex gap-2">

                                    <a asp-action="ChiTiet"
                                       asp-route-id="@item.Makh"
                                       class="action-btn btn-view">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    <a asp-action="Sua"
                                       asp-route-id="@item.Makh"
                                       class="action-btn btn-edit">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>

                                    @if (item.Taikhoan != null)
                                        @if (item.Taikhoan.Trangthai == "Đã đăng kí")
                                        {
                                            <a asp-action="Khoa"
                                               asp-route-id="@item.Makh"
                                               class="action-btn btn-warning"
                                               title="Khóa tài khoản">
                                                <i class="bi bi-lock-fill"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="MoKhoa"
                                               asp-route-id="@item.Makh"
                                               class="action-btn btn-success"
                                               title="Mở khóa tài khoản">
                                                <i class="bi bi-unlock-fill"></i>
                                            </a>
                                        }

                                    <a asp-action="Xoa"
                                       asp-route-Makh="@item.Makh"
                                       class="action-btn btn-delete">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>

                                </div>
                            }


                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>