@model duan_totnghiep.Models.Donhang

@{
    Layout = "_Layout";
}

<div class="detail-container">

    <div class="detail-card">

        <h2>CHI TIẾT ĐƠN HÀNG</h2>

        <div class="info-row">
            <span>Mã đơn:</span>
            <p>@Model.Madh</p>
        </div>

        <div class="info-row">
            <span>Khách hàng:</span>
            <p>@Model.Khachhang?.Hoten</p>
        </div>

        <div class="info-row">
            <span>Nhân viên:</span>
            <p>@Model.Nhanvien?.Hoten</p>
        </div>

        <div class="info-row">
            <span>Ngày đặt:</span>
            <p>@Model.Ngaydat?.ToString("dd/MM/yyyy")</p>
        </div>

        <div class="info-row">
            <span>Tổng tiền:</span>
            <span class="badge bg-success text-light">@Model.Tongtien.ToString("N0") VNĐ</span>
        </div>

        <div class="info-row">
            <span>Trạng thái:</span>
            <span class="badge bg-info text-dark">
                @Model.Trangthai
            </span>
        </div>

        <a asp-action="Index" class="btn-back">
            ← Quay lại
        </a>

    </div>

</div>