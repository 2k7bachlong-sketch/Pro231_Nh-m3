@model duan_totnghiep.Models.Sanpham

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}
<meta charset="utf-8" />
<title>StarPard Shop</title>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>

    .detail-container {
        width: 90%;
        margin: 40px auto;
        display: grid;
        grid-template-columns: 45% 55%;
        gap: 35px;
    }

    .detail-left {
        background: #fff;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
        display: flex;
        justify-content: center; /* căn ngang */
        align-items: center; /* căn dọc */
    }
    .image-box {
        width: 100%;
        height: 500px; /* hoặc 650px */
        overflow: hidden;
        border-radius: 20px;
        cursor: zoom-in;
    }

        .image-box img {
            width: 100%;
            height: 100%;
            object-fit: contain; /* FULL KHUNG */
            display: block;
            transition: .4s;
        }

        .image-box:hover img {
            transform: scale(1.15);
        }

    .detail-right h1 {
        font-size: 48px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .tag-group {
        display: flex;
        gap: 15px;
        margin-bottom: 25px;
    }

        .tag-group span {
            background: #fff;
            padding: 10px 20px;
            border-radius: 30px;
            box-shadow: 0 5px 15px rgba(0,0,0,.08);
            font-weight: 600;
        }

    .top-info {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 25px;
    }

    .price-box,
    .stock-box {
        background: #fff;
        padding: 25px;
        border-radius: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,.08);
    }

        .price-box small,
        .stock-box small {
            color: #888;
            font-weight: 600;
        }

        .price-box h2 {
            color: #e53935;
            font-size: 42px;
            margin-top: 10px;
        }

        .stock-box h2 {
            color: #1b9c59;
            font-size: 32px;
            margin-top: 10px;
        }

    .info-box {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,.08);
    }

        .info-box h3 {
            padding: 20px;
            border-bottom: 1px solid #eee;
        }

        .info-box table {
            width: 100%;
            border-collapse: collapse;
        }

        .info-box td {
            padding: 18px 20px;
            border-bottom: 1px solid #eee;
        }

            .info-box td:first-child {
                width: 180px;
                font-weight: 600;
                color: #666;
            }

    .button-group {
        display: flex;
        gap: 20px;
        margin-top: 30px;
    }

        .button-group a {
            flex: 1;
            text-align: center;
            text-decoration: none;
            color: white;
            padding: 18px;
            border-radius: 15px;
            font-size: 20px;
            font-weight: bold;
            transition: .3s;
        }

    .btn-green {
        background: #16a34a;
    }

        .btn-green:hover {
            background: #15803d;
            transform: translateY(-3px);
        }

    .btn-red {
        background: #ef4444;
    }

        .btn-red:hover {
            background: #dc2626;
            transform: translateY(-3px);
        }

    .btn-dark {
        background: #111827;
    }

        .btn-dark:hover {
            background: black;
            transform: translateY(-3px);
        }

    .service {
        width: 90%;
        margin: 0 auto 60px;
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 25px;
    }

    .service-box {
        background: #fff;
        border-radius: 18px;
        padding: 35px 20px;
        text-align: center;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
        transition: .3s;
    }

        .service-box:hover {
            transform: translateY(-8px);
        }

        .service-box i {
            font-size: 45px;
            color: #E63946;
            margin-bottom: 18px;
        }

        .service-box h3 {
            font-size: 22px;
            margin-bottom: 10px;
            color: #222;
        }

        .service-box p {
            color: #777;
            font-size: 15px;
            line-height: 1.6;
        }

    .in-stock {
        color: #16a34a !important;
    }

    .out-stock-text {
        color: #ef4444 !important;
    }

    .button-group button {
        flex: 1;
        border: none;
        padding: 18px;
        border-radius: 15px;
        font-size: 20px;
        font-weight: bold;
    }

    .btn-disabled {
        background: #d1d5db !important;
        color: #6b7280 !important;
        cursor: not-allowed;
        opacity: .9;
    }

    .size-box {
        margin: 30px 0;
    }

        .size-box h3 {
            margin-bottom: 15px;
            font-size: 22px;
        }

    .size-list {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

        .size-list input {
            display: none;
        }

        .size-list span {
            width: 58px;
            height: 58px;
            border: 2px solid #ddd;
            border-radius: 14px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            font-size: 18px;
            font-weight: bold;
            transition: .25s;
        }

            .size-list span:hover {
                border-color: #16a34a;
            }

        .size-list input:checked + span {
            background: #16a34a;
            color: #fff;
            border-color: #16a34a;
        }
</style>
<div class="detail-container">

    <!-- Ảnh -->
    <div class="detail-left">

        <div class="image-box">
            <img src="~/images/@Model.Hinhanh" alt="@Model.Tensp">
        </div>

    </div>

    <!-- Thông tin -->
    <div class="detail-right">

        <h1>@Model.Tensp</h1>

        <div class="tag-group">

            <span>@Model.Danhmuc?.Tendm</span>

            <span>@Model.Thuonghieu?.Tenth</span>

        </div>

        <div class="top-info">

            <div class="price-box">

                <small>GIÁ BÁN</small>

                <h2>@String.Format("{0:N0} đ", Model.Gia)</h2>

            </div>

            <div class="stock-box">

                <small>TÌNH TRẠNG KHO</small>

                @if (Model.Soluongton > 0)
                {
                    <h2 class="in-stock">Còn @Model.Soluongton sản phẩm</h2>
                }
                else
                {
                    <h2 class="out-stock-text">Hết hàng</h2>
                }

            </div>

        </div>

        <div class="size-box">

            <h3>Chọn Size</h3>

            <div class="size-list">

                <label>
                    <input type="radio" name="size" value="38">
                    <span>38</span>
                </label>

                <label>
                    <input type="radio" name="size" value="39">
                    <span>39</span>
                </label>

                <label>
                    <input type="radio" name="size" value="40">
                    <span>40</span>
                </label>

                <label>
                    <input type="radio" name="size" value="41">
                    <span>41</span>
                </label>

                <label>
                    <input type="radio" name="size" value="42">
                    <span>42</span>
                </label>

                <label>
                    <input type="radio" name="size" value="43">
                    <span>43</span>
                </label>

            </div>

        </div>

        <div class="info-box">

            <h3>Thông tin sản phẩm</h3>

            <table>

                <tr>

                    <td>Tên sản phẩm</td>

                    <td>@Model.Tensp</td>

                </tr>

                <tr>

                    <td>Danh mục</td>

                    <td>@Model.Danhmuc?.Tendm</td>

                </tr>

                <tr>

                    <td>Thương hiệu</td>

                    <td>@Model.Thuonghieu?.Tenth</td>

                </tr>

                <tr>

                    <td>Mô tả</td>

                    <td>
                        @(string.IsNullOrEmpty(Model.Mota)
                                                ? "Chưa có mô tả."
                                                : Model.Mota)
                    </td>

                </tr>

            </table>

        </div>

        <div class="button-group">

            @if (Model.Soluongton > 0)
            {
                <button type="button"
                        class="btn-green"
                        onclick="themVaoGio(@Model.Masp)">
                    🛒 Thêm vào giỏ
                </button>

                <button type="button"
                        class="btn-red"
                        onclick="muaNgay(@Model.Masp)">
                    ⚡ Mua ngay
                </button>
            }
            else
            {
                <button class="btn-green btn-disabled" disabled>
                    🛒 Hết hàng
                </button>

                <button class="btn-red btn-disabled" disabled>
                    ⚡ Mua ngay
                </button>
            }

            <a asp-action="Index" class="btn-dark">
                ← Quay lại
            </a>

        </div>

    </div>

</div>

<div class="service-title">

    <div class="service-text">
        <h2><span>UY TÍN</span> • CHẤT LƯỢNG</h2>
        <p>Cam kết mang đến những sản phẩm chính hãng với dịch vụ tốt nhất.</p>
    </div>

</div>

<div class="service">

    <div class="service-box">
        <i class="fa-solid fa-truck-fast"></i>
        <h3>Miễn phí vận chuyển</h3>
        <p>Đơn hàng từ 500.000đ</p>
    </div>

    <div class="service-box">
        <i class="fa-solid fa-shield-halved"></i>
        <h3>Chính hãng 100%</h3>
        <p>Cam kết hàng chất lượng</p>
    </div>

    <div class="service-box">
        <i class="fa-solid fa-rotate-left"></i>
        <h3>Đổi trả 7 ngày</h3>
        <p>Đổi nếu có lỗi từ nhà sản xuất</p>
    </div>

    <div class="service-box">
        <i class="fa-solid fa-headset"></i>
        <h3>Hỗ trợ 24/7</h3>
        <p>Luôn sẵn sàng tư vấn khách hàng</p>
    </div>


    <script>

        function laySize() {

            let size = document.querySelector("input[name='size']:checked");

            if (size == null) {
                alert("Vui lòng chọn size!");
                return null;
            }

            return size.value;
        }

        function themVaoGio(id) {

            let size = laySize();

            if (size == null)
                return;

            window.location.href = "/Giohang/ThemVaoGio?id=" + id + "&size=" + size;
        }

        function muaNgay(id) {

            let size = laySize();

            if (size == null)
                return;

            window.location.href = "/Giohang/MuaNgay?id=" + id + "&size=" + size;
        }

    </script>
