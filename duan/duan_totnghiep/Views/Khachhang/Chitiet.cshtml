@model duan_totnghiep.Models.Khachhang

@{
    Layout = "_Layout";
}

<div class="detail-header">

    <div>
        <span class="page-tag">
            👤 Khách hàng
        </span>

        <h2>Chi tiết khách hàng</h2>

        <p>Thông tin và lịch sử mua hàng của khách.</p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i>
        Quay lại
    </a>

</div>

    <div class="detail-card">

        <div class="detail-row">
            <span>Mã khách</span>
            <strong>#@Model.Makh</strong>
        </div>

        <div class="detail-row">
            <span>Họ tên</span>
            <strong>@Model.Hoten</strong>
        </div>

        <div class="detail-row">
            <span>Số điện thoại</span>
            <strong>@Model.Sdt</strong>
        </div>

        <div class="detail-row">
            <span>Email</span>
            <strong>@Model.Email</strong>
        </div>

        <div class="detail-row">
            <span>Địa chỉ</span>
            <strong>@Model.Diachi</strong>
        </div>

        <div class="detail-row">
            <span>Loại khách</span>

            @if (Model.Matk == null)
            {
                <span class="badge bg-white-50">
                    Khách vãng lai
                </span>
            }
            else
            {
                <span class="badge bg-success">
                    Thành viên
                </span>
            }

        </div>

        <div class="detail-row">
            <span>Số đơn hàng</span>

            <span class="badge bg-info">
                @Model.Donhangs.Count
            </span>

        </div>

        <div class="detail-row">
            <span>Tổng chi tiêu</span>

            <strong class="text-success">

                @(Model.Donhangs
                    .Where(x => x.Trangthai == "Đã hoàn thành")
                    .Sum(x => x.Tongtien)
                    .ToString("N0")) VNĐ

            </strong>

        </div>

    </div>

</div>