@model List<duan_totnghiep.Models.Sanpham>

@{
    ViewData["Title"] = "Trang mua hàng";
    Layout = "_LayoutAdmin";
}
<!DOCTYPE html>
<html>
<head>
   
    <meta charset="utf-8" />
    <title>StarPard Shop</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #f5f5f5;
            font-family: Arial, sans-serif;
        }

        /* ================= HEADER ================= */

        .header {
            width: 92%;
            margin: 18px auto 25px;
            background: #fff;
            border-radius: 22px;
            height: 140px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 35px;
            box-shadow: 0 10px 25px rgba(0,0,0,.08);
        }

        .logo img {
            width: 95px;
        }

        .search-box {
            flex: 1;
            margin: 0 40px;
        }

            .search-box form {
                display: flex;
                align-items: center;
                background: white;
                border: 2px solid #ddd;
                border-radius: 40px;
                overflow: hidden;
                height: 60px;
            }

            .search-box button {
                width: 70px;
                border: none;
                background: white;
                font-size: 22px;
                color: #555;
            }

            .search-box input {
                flex: 1;
                border: none;
                outline: none;
                padding-left: 20px;
                font-size: 24px;
            }

        .right-menu {
            display: flex;
            gap: 25px;
            align-items: center;
        }

            .right-menu a {
                text-decoration: none;
                padding: 10px 18px;
                border-radius: 30px;
                font-size: 18px;
                font-weight: 600;
                transition: .3s;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .right-menu i {
                font-size: 18px;
            }   
        .btn-contact {
            background: white;
            color: #111;
            border: 2px solid #ddd;
        }

        .btn-cart {
            background: #111;
            color: white;
        }

        .btn-logout {
            background: #ef4444;
            color: white;
        }

        .right-menu a:hover {
            transform: translateY(-3px);
        }

        /* DANH MỤC */

        .category {
            width: 92%;
            margin: auto;
            height: 65px;
            background: #111;
            border-radius: 18px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 70px;
            box-shadow: 0 8px 20px rgba(0,0,0,.15);
        }

            .category a {
                color: white;
                text-decoration: none;
                font-size: 17px;
                font-weight: 600;
                padding: 12px 22px;
                border-radius: 30px;
                transition: .3s;
            }

                .category a:hover {
                    background: #E63946;
                }
        /* BANNER */

        .banner {
            width: 100%;
            display: flex;
            justify-content: center;
            margin: 30px 0;
        }

            .banner img {
                width: 92%;
                height: 830px;
                object-fit: cover;
                border-radius: 25px;
                transition: .4s;
            }

.banner img:hover{
    transform: scale(1.02);
}

        .products {
            width: 100%;
            margin: 0 auto;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 45px;
        }
        .card {
            width: 220px;
            background: #fff;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 8px 18px rgba(0,0,0,.12);
            transition: .3s;
            position: relative;
        }

            .card:hover {
                transform: translateY(-10px) scale(1.03);
                box-shadow: 0 18px 35px rgba(0,0,0,.22);
            }
            .card img {
                width: 100%;
                height: 220px; /* cao hơn */
                object-fit: cover; /* ảnh full khung */
                display: block;
                padding: 0; /* bỏ khoảng trắng */
                border-radius: 18px 18px 0 0; /* bo góc phía trên */
                background: transparent;
            }

            .card:hover img {
                transform: scale(1.08);
            }
            .card h3 {
                width: 100%;
                margin: 15px 0 10px;
                padding: 0 10px;
                text-align: center !important;
                font-size: 18px;
                font-weight: 700;
            }

        .price {
            margin: 8px 0 16px;
            text-align: center; /* ra giữa */
            font-weight: bold;
            line-height: 1.4;
        }

        .old-price {
            color: #999;
            text-decoration: line-through;
            font-size: 14px; /* nhỏ lại */
        }

        .new-price {
            color: #e63946;
            font-size: 22px; /* nhỏ hơn trước */
            font-weight: 700;
        }
  
        .product-buttons {
            padding: 0 15px 18px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .btn-detail,
        .btn-giohang {
            padding: 13px;
            border-radius: 12px;
            text-align: center;
            text-decoration: none;
            font-weight: 600;
            display: block;
            cursor: pointer;
        
        }

        .btn-detail {
            background: #111827;
            color: #fff;
        }

            .btn-detail:hover {
                background: #000;
            }

        .btn-giohang {
            background: #16a34a;
            color: #fff;
        }

            .btn-giohang:hover {
                background: #15803d;
            }

        .sale-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            background: #ff2d55;
            color: #fff;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: bold;
        }

        .stock-badge {
            top: 15px;
            right: 15px;
        }
        .btn-detail {
            background: #222;
            color: #fff;
            text-decoration: none;
            text-align: center;
            padding: 10px;
            border-radius: 8px;
            transition: .3s;
        }

            .btn-detail:hover {
                background: #000;
            }

        .btn-giohang {
            background: #28a745;
            color: #fff;
            text-decoration: none;
            text-align: center;
            padding: 10px;
            border-radius: 8px;
            transition: .3s;
        }

            .btn-giohang:hover {
                background: #218838;
            }

      
.toast{
    position:fixed;
    top:20px;
    right:20px;

    background:#28a745;
    color:white;

    padding:15px 25px;

    border-radius:10px;

    font-weight:bold;

    box-shadow:0 5px 15px rgba(0,0,0,.3);

    z-index:9999;

    animation:fadein .5s;
}

        /* ======= TITLE ======= */

        .section-title {
            width: 100%;
            margin: 40px auto 25px;
            display: flex;
            align-items: center;
            gap: 20px;
        }

            .section-title::before,
            .section-title::after {
                content: "";
                flex: 1;
                height: 2px;
                background: #ddd;
            }

            .section-title h2 {
                color: #111;
                font-size: 48px;
                font-weight: bold;
            }

            .section-title span {
                color: #E63946;
            }

        /* ======= SERVICE ======= */

        .service {
            width: 92%;
            margin: 70px auto;
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 25px;
        }

        .service-box {
            background: white;
            border-radius: 18px;
            padding: 30px;
            text-align: center;
            box-shadow: 0 8px 20px rgba(0,0,0,.08);
            transition: .3s;
        }

            .service-box:hover {
                transform: translateY(-8px);
            }

            .service-box i {
                font-size: 45px;
                color: #E63946;
                margin-bottom: 15px;
            }

            .service-box h3 {
                margin-bottom: 10px;
            }

            .service-box p {
                color: #666;
                font-size: 15px;
            }

        /* ======= SALE ======= */

        .sale-banner {
            width: 92%;
            margin: 35px auto;
            background: linear-gradient(90deg,#111,#E63946);
            border-radius: 22px;
            padding: 35px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
        }

            .sale-banner h2 {
                font-size: 40px;
            }

            .sale-banner p {
                margin-top: 10px;
                font-size: 18px;
            }

            .sale-banner a {
                text-decoration: none;
                color: white;
                background: white;
                color: #111;
                padding: 14px 28px;
                border-radius: 35px;
                font-weight: bold;
            }

        /* ===== CAM KẾT ===== */

        .service-title {
            width: 100%;
            margin: 70px auto 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
        }

            .service-title::before,
            .service-title::after {
                content: "";
                flex: 1;
                height: 2px;
                background: #ddd;
            }

        .service-text {
            text-align: center;
        }

            .service-text h2 {
                font-size: 36px;
                color: #111;
                margin-bottom: 8px;
            }

                .service-text h2 span {
                    color: #E63946;
                }

            .service-text p {
                color: #666;
                font-size: 17px;
            }

        /*================ CHUÔNG THÔNG BÁO =================*/

        .notify-area {
            position: relative;
        }

        .notify-btn {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            border: 2px solid #dcdcdc;
            background: #fff;
            color: #111;
            cursor: pointer;
            transition: .3s;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .notify-btn:hover {
                background: #111827;
                color: #fff;
                border-color: #111827;
            }


        .btn-icon {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            border: 2px solid #dcdcdc;
            background: #fff;
            color: #111;
            text-decoration: none;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: .3s;
        }

        .btn-icon:hover {
            background: #111827;
            color: #fff;
            border-color: #111827;
        }
        .notify-count {
            position: absolute;
            top: -6px;
            right: -6px;
            min-width: 22px;
            height: 22px;
            padding: 0 6px;
            border-radius: 50px;
            background: #ef4444;
            color: #fff;
            font-size: 12px;
            font-weight: bold;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .notify-panel {
            position: absolute;
            top: 65px;
            right: 0;
            width: 380px;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 15px 40px rgba(0,0,0,.15);
            display: none;
            overflow: hidden;
            z-index: 99999;
        }

        .notify-header {
            background: #111827;
            color: #fff;
            padding: 18px 22px;
        }

            .notify-header h3 {
                margin: 0;
                font-size: 20px;
            }

        #notifyList {
            max-height: 420px;
            overflow-y: auto;
        }

        .notify-item {
            display: flex;
            gap: 15px;
            padding: 18px;
            border-bottom: 1px solid #eee;
            text-decoration: none;
            color: inherit;
            cursor: pointer;
            transition: .25s;
        }

            .notify-item:hover {
                background: #f3f4f6;
                transform: translateX(5px);
            }

            .notify-item:active {
                transform: scale(.98);
            }

            .notify-item:last-child {
                border-bottom: none;
            }

        .notify-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #fff;
            font-size: 20px;
        }

        .stock-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            background: #22c55e;
            color: #fff;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
            box-shadow: 0 4px 10px rgba(0,0,0,.15);
        }

            .stock-badge.out {
                background: #ef4444;
            }

        .notify-content {
            flex: 1;
        }

            .notify-content h4 {
                margin: 0;
                font-size: 16px;
            }

            .notify-content p {
                margin: 6px 0;
                color: #555;
                font-size: 14px;
            }

        .notify-time {
            color: #999;
            font-size: 12px;
        }

        .notify-empty {
            padding: 50px 20px;
            text-align: center;
            color: #888;
        }

        /* Màu */

        .bg-waiting {
            background: #f59e0b;
        }

        .bg-success {
            background: #22c55e;
        }

        .bg-shipping {
            background: #3b82f6;
        }

        .bg-done {
            background: #10b981;
        }

        .bg-cancel {
            background: #ef4444;
        }

        .btn-giohang.out-stock {
            background: #d1d5db !important;
            color: #6b7280 !important;
            cursor: not-allowed;
            border: none;
            pointer-events: none;
            opacity: .9;
        }

            .btn-giohang.out-stock:hover {
                background: #d1d5db !important;
                transform: none;
            }

        .new-badge {
            display: inline-block;
            margin-left: 8px;
            padding: 3px 10px;
            background: #ef4444;
            color: #fff;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .popup {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.45);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        .popup-content {
            width: 420px;
            background: #fff;
            border-radius: 18px;
            padding: 30px;
            text-align: center;
        }

        .size-list {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin: 25px 0;
        }

        .size-btn {
            width: 55px;
            height: 55px;
            border-radius: 10px;
            border: 2px solid #ddd;
            background: white;
            cursor: pointer;
            font-size: 18px;
        }

        .product-popup {
            width: 450px;
            border-radius: 25px;
        }

            .product-popup img {
                width: 220px;
                height: 220px;
                object-fit: cover;
                border-radius: 15px;
            }

            .product-popup h2 {
                margin: 15px 0;
            }

            .product-popup p {
                font-size: 18px;
                margin: 8px;
            }

            .size-btn.active {
                background: #111;
                color: white;
                border-color: #111;
            }

        #btnAddCart {
            width: 100%;
            height: 50px;
            border: none;
            border-radius: 10px;
            background: #16a34a;
            color: white;
            font-size: 18px;
            cursor: pointer;
        }

        .popup {
            position: fixed;
            inset: 0;
            display: none;
            justify-content: center;
            align-items: center;
            background: rgba(0,0,0,.45);
            z-index: 999999;
        }
        /* Rung chuông */

        @@keyframes bellShake {

            0% {
                transform: rotate(0);
            }

            20% {
                transform: rotate(-18deg);
            }

            40% {
                transform: rotate(18deg);
            }

            60% {
                transform: rotate(-12deg);
            }

            80% {
                transform: rotate(12deg);
            }

            100% {
                transform: rotate(0);
            }
        }
    </style>
</head>
<body>
    @* Thêm SP vào giỏ *@
    @if (TempData["Success"] != null)
    {
        <div class="toast" id="toast">
            ✔ @TempData["Success"]
        </div>

        <script>
                setTimeout(function(){
                    document.getElementById("toast").style.display="none";
                },2500);
        </script>
    }

    <!-- HEADER -->

    <div class="header">
        <div class="logo">
            <a asp-controller="Trangmua" asp-action="Index">
                <img src="~/images/starlogo.png" alt="Logo">
            </a>
        </div>

        <div class="search-box">

            <form asp-controller="Trangmua"
                  asp-action="Index"
                  method="get">

                <button type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>

                <input type="text"
                       name="searchString"
                       placeholder="Tìm kiếm sản phẩm..." />

            </form>

        </div>

        <div class="right-menu">

            <!-- Chuông thông báo -->
            <div class="notify-area">

                <button id="btnNotify" class="notify-btn">

                    <i class="fa-solid fa-bell"></i>

                    <span id="notifyCount" class="notify-count">
                        @(ViewBag.DonHangs != null ? ((IEnumerable<dynamic>)ViewBag.DonHangs).Count() : 0)
                    </span>

                </button>

                <div id="notifyPanel" class="notify-panel">

                    <div class="notify-header">
                        <h3>
                            <i class="fa-solid fa-bell"></i>
                            Thông báo
                        </h3>
                    </div>

                    <div id="notifyList">

                        @if (ViewBag.DonHangs != null)
                        {
                            @foreach (var dh in ViewBag.DonHangs)
                            {
                                string color = "bg-waiting";
                                string icon = "fa-clock";

                                if (dh.Trangthai == "Đã xác nhận")
                                {
                                    color = "bg-success";
                                    icon = "fa-circle-check";
                                }
                                else if (dh.Trangthai == "Đang giao")
                                {
                                    color = "bg-shipping";
                                    icon = "fa-truck-fast";
                                }
                                else if (dh.Trangthai == "Đã hoàn thành")
                                {
                                    color = "bg-done";
                                    icon = "fa-box-open";
                                }
                                else if (dh.Trangthai == "Đã hủy"
                                || dh.Trangthai == "Giao thất bại")
                                {
                                    color = "bg-cancel";
                                    icon = "fa-circle-xmark";
                                }

                                <a asp-controller="Donhang"
                                   asp-action="Cuatoi"
                                   asp-route-id="@dh.Madh"
                                   class="notify-item">

                                    <div class="notify-icon @color">

                                        <i class="fa-solid @icon"></i>

                                    </div>

                                    <div class="notify-content">

                                        <h4>

                                            Đơn hàng #@dh.Madh

                                            @if (dh.Trangthai == "Chờ xác nhận"
                                                || dh.Trangthai == "Đã xác nhận"
                                                || dh.Trangthai == "Đang giao")
                                            {
                                                <span class="new-badge">
                                                    Mới
                                                </span>
                                            }

                                        </h4>

                                        <p>
                                            @dh.Trangthai
                                        </p>

                                    </div>

                                </a>
                            }
                        }
                        else
                        {
                            <div class="notify-empty">
                                Chưa có thông báo nào.
                            </div>
                        }

                    </div>

                </div>

            </div>
            <a asp-controller="Thongtin"
               asp-action="Index"
               class="btn-icon">

                <i class="fa-solid fa-user"></i>

            </a>

            <a asp-controller="Giohang"
               asp-action="Index"
               class="btn-cart">

                <i class="fa-solid fa-cart-shopping"></i>

                Giỏ hàng

            </a>

            <a asp-controller="Giaodien"
               asp-action="Index"
               class="btn-logout">

                <i class="fa-solid fa-right-from-bracket"></i>

                Đăng xuất

            </a>

        </div>
    </div>

    <!-- DANH MỤC -->


    <div class="category">

        <a asp-controller="Danhmuc"
           asp-action="List"
           asp-route-id="1"
           asp-route-returnController="Trangmua">
            <i class="fa-solid fa-person-running"></i>
            Giày thể thao
        </a>

        <a asp-controller="Danhmuc"
           asp-action="List"
           asp-route-id="2"
           asp-route-returnController="Trangmua">
            <i class="fa-solid fa-shop"></i>
            Giày da
        </a>

        <a asp-controller="Danhmuc"
           asp-action="List"
           asp-route-id="3"
           asp-route-returnController="Trangmua">
            <i class="fa-solid fa-person-dress"></i>
            Giày cao gót
        </a>

        <!-- Thêm dòng này -->
        <a asp-controller="Trangmua"
           asp-action="Vongquay">
            <i class="fa-solid fa-gift"></i>
            Vòng quay may mắn
        </a>

        <a asp-controller="Voucher"
           asp-action="Index">
            <i class="fa-solid fa-ticket"></i>
            Voucher của tôi
        </a>
    </div>
    <!-- BANNER -->
    <div class="banner">
        <img id="banner-image"
             src="/images/banner1.jpg"
             alt="Banner">     
    </div>

    <div class="sale-banner">

        <div>
            <h2>🔥 SIÊU SALE</h2>
            <p>Giảm đến 50% tất cả giày thể thao</p>
        </div>

        <a href="javascript:void(0)" id="btnSale">
            Mua ngay
        </a>

    </div>

    <div class="section-title">
        <h2><span>SẢN PHẨM</span> NỔI BẬT</h2>
    </div>

    <!-- SẢN PHẨM -->

    <div class="products">

        @foreach (var item in Model)
        {
            <div class="card">
                @if (item.Khuyenmai != null &&
                            item.Khuyenmai.TrangThaiHienThi == "Hoạt động")
                {
                    <div class="sale-badge">
                        -@item.Khuyenmai.Phantramgiam%
                    </div>
                }

                <img src="~/images/@item.Hinhanh" />

                @if (item.Soluongton > 0)
                {
                    <div class="stock-badge">
                        Còn: @item.Soluongton
                    </div>
                }
                else
                {
                    <div class="stock-badge out">
                        Hết hàng
                    </div>
                }

                <h3>@item.Tensp</h3>

                @if (item.Khuyenmai != null &&
                            item.Khuyenmai.TrangThaiHienThi == "Hoạt động")
                {
                    var giaMoi = item.Gia * (100 - item.Khuyenmai.Phantramgiam) / 100;

                    <div class="price">

                        <span class="old-price">
                            @String.Format("{0:N0} đ", item.Gia)
                        </span>

                        <br />

                        <span class="new-price">
                            @String.Format("{0:N0} đ", giaMoi)
                        </span>

                    </div>
                }
                else
                {
                    <div class="price">
                        @String.Format("{0:N0} đ", item.Gia)
