@{
    ViewData["Title"] = "Trang chủ";
}
@{
    Layout = "_LayoutAdmin";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>StarPard Shop</title>
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap"
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;

        }

        body {
            background: #f5f5f5;
            font-family: "Be Vietnam Pro", sans-serif;
        }

        /* HEADER */

        .header {
            width: 92%;
            margin: 20px auto;
            background: #fff;
            border-radius: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 35px;
            box-shadow: 0 8px 20px rgba(0,0,0,.08);
        }

        .logo img {
            width: 90px;
        }

        .search-box {
            width: 45%;
            height: 55px;
            border: 1px solid #ddd;
            border-radius: 40px;
            display: flex;
            align-items: center;
            padding: 0 20px;
        }

            .search-box i {
                color: #888;
                margin-right: 10px;
            }

            .search-box input {
                flex: 1;
                border: none;
                outline: none;
                font-size: 16px;
            }

        .header-right {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .icon-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 20px 20px;
            border-radius: 35px;
            text-decoration: none;
            color: #333;
            border: 1px solid #ddd;
            transition: .3s;
        }

            .icon-btn i {
                font-size: 20px;
            }

            .icon-btn:hover {
                background: #E63946;
                color: white;
                border-color: #E63946;
            }

        .main-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 13px 24px;
            border-radius: 40px;
            text-decoration: none;
            color: white;
            background: #111;
            font-weight: bold;
            transition: .3s;
        }

            .main-btn:hover {
                background: #E63946;
                transform: translateY(-2px);
            }

        .register {
            background: #E63946;
        }

            .register:hover {
                background: #c62839;
            }

        .right-menu {
            display: flex;
            align-items: center;
            gap: 30px;
        }

            .right-menu i {
                font-size: 22px;
                color: black;
            }

            .btn-dangki {
                background: black;
                color: white;
                padding: 12px 25px;
                border-radius: 30px;
                text-decoration: none;
                font-size: 22px;
                position: relative;
                overflow: hidden;
                transition: all 0.3s ease;
            }
                .btn-dangki::before {
                    content: "";
                    position: absolute;
                    top: 0;
                    left: -100%;
                    width: 100%;
                    height: 100%;
                    background: linear-gradient( 120deg, transparent, rgba(255,255,255,0.4), transparent );
                    transition: 0.6s;
                }

                .btn-dangki:hover::before {
                    left: 100%;
                }

        /* DANH MỤC */

        .category {
            width: 92%;
            margin: auto;
            height: 65px;
            background: #111;
            border-radius: 18px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 70px;
            box-shadow: 0 8px 20px rgba(0,0,0,.15);
        }

            .category a {
                color: white;
                text-decoration: none;
                font-size: 17px;
                font-weight: 600;
                padding: 12px 22px;
                border-radius: 30px;
                transition: .3s;
            }

                .category a:hover {
                    background: #E63946;
                }


            /* BANNER */

            .banner {
                width: 100%;
                display: flex;
                justify-content: center;
                margin: 30px 0;
            }

            .banner img {
                width: 92%;
                height: 830px;
                object-fit: cover;
                border-radius: 25px;
                transition: .4s;
            }
.banner img:hover{
    transform: scale(1.02);
}
        /* SẢN PHẨM */
        .section-title {
            width: 92%;
            margin: 60px auto 40px;
            background: #fff;
            border-radius: 22px;
            padding: 35px 20px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,.08);
            border: 1px solid #eee;
            position: relative;
            overflow: hidden;
        }

            /* Dải màu phía trên */

            .section-title::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 6px;
                background: linear-gradient(90deg,#ff3131,#111,#ff3131);
            }

            /* Hai vòng tròn trang trí */

            .section-title::after {
                content: "";
                position: absolute;
                width: 220px;
                height: 220px;
                background: rgba(255,49,49,.05);
                border-radius: 50%;
                top: -120px;
                right: -80px;
            }

        .title-top {
            color: #ff3131;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 4px;
            margin-bottom: 10px;
        }

            .title-top i {
                margin-right: 8px;
                font-size: 20px;
            }

        .section-title h2 {
            font-size: 46px;
            font-weight: 800;
            color: #111;
            margin-bottom: 10px;
        }

        .section-title p {
            color: #777;
            font-size: 18px;
        }

        .section-title b {
            color: #ff3131;
        }

        .products {
            margin-top: 50px;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 60px;
        }

        .card {
            position: relative;
            width: 220px;
            min-height: 330px; /* tăng chiều cao */
            background: #fff;
            border: 5px solid #111;
            border-radius: 22px;
            padding: 0px;
            text-align: center;
            overflow: hidden;
            transition: .3s;
        }

            .card:hover {
                transform: translateY(-8px);
                box-shadow: 0 15px 30px rgba(0,0,0,.2);
            }

            .card img {
                width: 100%;
                height: 200px;
                border-radius: 8px;
                object-fit: cover;
                display: block;
                margin: 0 auto 10px;
                transition: .3s;
            }

            .card:hover img {
                transform: scale(1.05);
            }

            .card h3 {
                margin-top: 10px;
                font-size: 15px;
            }

        .card {
            position: relative;
            overflow: hidden;
        }

        .sale-badge {
            position: absolute;
            top: 18px;
            left: 18px;
            background: #ff3b30;
            color: #fff;
            padding: 8px 16px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: bold;
            box-shadow: 0 5px 12px rgba(0,0,0,.2);
        }

        .old-price {
            margin-top: 15px;
            font-size: 18px;
            color: #999;
            text-decoration: line-through;
        }

        .price {
            margin-top: 8px;
            font-size: 25px;
            font-weight: 800;
            color: #E63946;
        }

        .logo-text {
            font-size: 36px;
            font-weight: 800;
            color: black;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .title-product {
            width: 92%;
            margin: 50px auto 30px;
            text-align: center;
        }

            .title-product h2 {
                font-size: 34px;
                color: #111;
                margin-bottom: 10px;
            }

                .title-product h2 i {
                    color: #E63946;
                }

            .title-product p {
                color: #777;
            }

        .rating {
            margin: 15px 0;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 4px;
        }

            .rating i {
                color: #ffc107;
                font-size: 18px;
            }
        /*========== STATS =========*/

        .section-heading {
            width: 100%;
            margin: 80px auto 50px;
            text-align: center;
            position: relative;
        }

            .section-heading::before {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                top: 18px;
                height: 2px;
                background: #ddd;
                z-index: 1;
            }

            .section-heading small {
                display: inline-block;
                position: relative;
                z-index: 2;
                background: #f5f5f5;
                padding: 0 15px;
                color: #e63946;
                font-size: 14px;
                font-weight: 700;
                letter-spacing: 5px;
            }

            .section-heading h2 {
                margin-top: 15px;
                font-size: 48px;
                font-weight: 800;
                color: #111;
            }

            .section-heading p {
                margin-top: 10px;
                font-size: 18px;
                color: #666;
            }

            .section-heading span {
                color: #e63946;
                font-weight: 700;
            }
        .stats {
            width: 92%;
            margin: 50px auto 80px;
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 30px;
        }

        .stat-box {
            background: #fff;
            padding: 40px 25px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 10px 25px rgba(0,0,0,.08);
            transition: .3s;
        }

            .stat-box:hover {
                transform: translateY(-10px);
                box-shadow: 0 15px 35px rgba(0,0,0,.15);
            }

            .stat-box i {
                font-size: 48px;
                color: #E63946;
                margin-bottom: 20px;
            }

            .stat-box h2 {
                font-size: 42px;
                font-weight: 800;
                color: #111;
                margin-bottom: 10px;
            }

            .stat-box p {
                font-size: 18px;
                color: #666;
                font-weight: 500;
            }
    </style>
</head>
<body>

    <!-- HEADER -->

    <header class="header">

        <div class="logo">
            <a href="/Giaodien/Index">
                <img src="~/images/starlogo.png" alt="StarPard">
            </a>
        </div>

        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Tìm kiếm sản phẩm...">
        </div>

        <div class="header-right">


            <a href="/Taikhoan/Index" class="main-btn login">
                <i class="fa-regular fa-user"></i>
