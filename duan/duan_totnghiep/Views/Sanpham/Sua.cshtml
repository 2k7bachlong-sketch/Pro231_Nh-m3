@model duan_totnghiep.Models.Sanpham

@{
    Layout = "_Layout";
}

<div class="dashboard-header">

    <div>

        <span class="page-tag">
            QUẢN LÝ
        </span>

        <h2>
            <i class="bi bi-pencil-square"></i>
            Sửa sản phẩm
        </h2>

        <p>
            Cập nhật thông tin sản phẩm.
        </p>

    </div>

</div>

<div class="form-card">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         style="display:none"
         id="validationSummary">
    </div>

    <form asp-action="Sua"
          method="post"
          enctype="multipart/form-data">

        <input type="hidden" asp-for="Masp" />
        <input type="hidden" asp-for="Hinhanh" />

        <div class="row">

            <div class="col-md-12 mb-3">

                <label class="form-label">Tên sản phẩm</label>

                <input asp-for="Tensp"
                       class="form-control" />

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">Giá bán</label>

                <input asp-for="Gia"
                       class="form-control" />

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">Số lượng tồn</label>

                <input asp-for="Soluongton"
                       class="form-control" />

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">Danh mục</label>

                <select asp-for="Madm"
                        asp-items="ViewBag.Madm"
                        class="form-select">
                </select>

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">Thương hiệu</label>

                <select asp-for="Math"
                        asp-items="ViewBag.Math"
                        class="form-select">
                </select>

            </div>

            <div class="col-md-12 mb-3">

                <label class="form-label">
                    Khuyến mãi
                </label>

                <select asp-for="Makm"
                        asp-items="ViewBag.Makm"
                        class="form-select">

                    <option value="">
                        -- Không áp dụng --
                    </option>

                </select>

            </div>

            <div class="col-md-12 mb-4">

                <label class="form-label">
                    Hình ảnh hiện tại
                </label>

                <div class="image-upload-card">

                    <img id="previewImage"
                         src="~/images/@Model.Hinhanh"
                         alt="Ảnh sản phẩm" />

                    <div class="mt-3">

                        <input type="file"
                               id="imageUpload"
                               name="fileAnh"
                               class="form-control"
                               accept="image/*" />

                    </div>

                    <small id="fileName"
                           class="text-muted mt-2 d-block">

                        Chọn ảnh mới nếu muốn thay đổi

                    </small>

                </div>

            </div>

        </div>

        <div class="form-footer">

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>

                Quay lại

            </a>

            <button class="btn btn-add">

                <i class="bi bi-check-circle-fill"></i>

                Cập nhật

            </button>

        </div>

    </form>

</div>

<script>

    const upload=document.getElementById("imageUpload");

    const preview=document.getElementById("previewImage");

    const fileName=document.getElementById("fileName");

    upload.addEventListener("change",function(){

        if(this.files.length===0) return;

        fileName.textContent=this.files[0].name;

        const reader=new FileReader();

        reader.onload=function(e){

            preview.src=e.target.result;

        }

        reader.readAsDataURL(this.files[0]);

    });

</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const summary = document.getElementById("validationSummary");

        if (summary && summary.innerText.trim() !== "") {
            summary.style.display = "block";
        }

    });
</script>