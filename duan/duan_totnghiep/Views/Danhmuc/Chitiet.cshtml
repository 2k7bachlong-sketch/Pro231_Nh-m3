@model duan_totnghiep.Models.Danhmuc

@{
    Layout = "_Layout";
}

<div class="detail-container">

    <div class="detail-card">

        <div class="detail-header">

            <span class="page-tag">CHI TIẾT</span>

            <h2>

                <i class="bi bi-folder2-open"></i>

                Chi tiết danh mục

            </h2>

        </div>

        <div class="info-row">

            <span>Mã danh mục</span>

            <p>@Model.Madm</p>

        </div>

        <div class="info-row">

            <span>Tên danh mục</span>

            <p>@Model.Tendm</p>

        </div>

        <div class="info-row">

            <span>Mô tả</span>

            <p>@Model.Mota</p>

        </div>

        <div class="info-row">

            <span>Số sản phẩm</span>

            <p>

                <span class="badge bg-primary">

                    @Model.Sanphams.Count sản phẩm

                </span>

            </p>

        </div>

        <a asp-action="Index"
           class="btn-back">

            <i class="bi bi-arrow-left"></i>

            Quay lại

        </a>

    </div>

</div>