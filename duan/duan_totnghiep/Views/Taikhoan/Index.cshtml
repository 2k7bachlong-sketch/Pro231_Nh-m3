@model duan_totnghiep.Models.Taikhoan
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Đăng nhập StarPard</title>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@500;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Segoe UI,sans-serif;
        }

        body {
            background: #f6f7fb;
        }

        /*================ HEADER =================*/

        .header {
            width: 92%;
            height: 90px;
            margin: 20px auto 12px;
            background: grey;
            border-radius: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 35px;
            box-shadow: 0 15px 40px rgba(0,0,0,.18);
        }

        .logo {
            width: 90px;
            transition: .3s;
        }

            .logo:hover {
                transform: scale(1.08);
            }

        .header-center {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            text-align: center;
        }

            .header-center h1 {
                margin: 0;
                font-size: 52px;
                font-weight: 900;
                color: black;
                letter-spacing: 2px;
                text-transform: uppercase;
                font-family: 'Arial Black',sans-serif;
                text-shadow: 0 4px 12px rgba(0,0,0,.25);
                line-height: 1;
            }

            .header-center span {
                display: block;
                margin-top: 6px;
                color: white;
                font-size: 15px;
                letter-spacing: 6px;
                text-transform: uppercase;
                font-weight: 600;
            }

    
        .container {
            max-width: 1300px;
            margin: 35px auto;
            display: flex;
            justify-content: center;
            align-items: flex-start; /* Quan trọng */
            gap: 30px;
            padding: 0 20px;
        }
        /*================ LEFT =================*/

        .left {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .left img {
                width: 330px;
                display: block;
                margin: 0 auto;
            }

            .left h1 {
                font-size: 58px;
                font-weight: 800;
                text-align: center;
                margin: 20px 0 10px;
            }

            .left p {
                text-align: center;
                color: #666;
                font-size: 30px;
            }

        .icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 5px 15px rgba(0,0,0,.08);
            display: flex;
            justify-content: center;
            align-items: center;
            color: #ff3030;
            font-size: 24px;
            margin-right: 18px;
        }

       

        /*================ LOGIN =================*/

        .right {
            width: 430px;
            background: #fff;
            border-radius: 25px;
            padding: 45px;
            box-shadow: 0 20px 50px rgba(0,0,0,.12);
            margin-top: -5px; /* Thêm dòng này */
        }

        .title {
            text-align: center;
            font-size: 40px;
            font-weight: bold;
        }

        .line {
            width: 70px;
            height: 4px;
            background: #ff3030;
            border-radius: 10px;
            margin: 15px auto 35px;
        }

        .input-group {
            position: relative;
            margin-bottom: 22px;
        }

            .input-group .fa-user,
            .input-group .fa-lock {
                position: absolute;
                left: 18px;
                top: 18px;
                color: #888;
            }

        .toggle-password {
            position: absolute;
            right: 18px;
            top: 18px;
            left: auto;
            cursor: pointer;
            color: #888;
        }

            .toggle-password:hover {
                color: #111;
            }

        .input-box {
            width: 100%;
            height: 55px;
            border-radius: 14px;
            border: 1px solid #ddd;
            padding-left: 50px;
            padding-right: 50px;
            font-size: 17px;
        }

            .input-box:focus {
                outline: none;
                border: 2px solid #ff3030;
            }
        .btn {
            width: 100%;
            height: 55px;
            border: none;
            border-radius: 15px;
            background: #111;
            color: white;
            font-size: 20px;
            cursor: pointer;
            transition: .3s;
            margin-top: 10px;
        }

            .btn:hover {
                background: #ff3030;
            }

        .option {
            margin-top: 20px;
            display: flex;
            justify-content: space-between;
        }

            .option a {
                text-decoration: none;
                color: #ff3030;
            }

        .register {
            text-align: center;
            margin-top: 30px;
        }

            .register a {
                color: #ff3030;
                font-weight: bold;
                text-decoration: none;
            }

        .back-home {
            margin-top: 18px;
            text-align: center;
        }

            .back-home a {
                text-decoration: none;
                color: #555;
            }

                .back-home a:hover {
                    color: #ff3030;
                }

        .error {
            background: #ffe5e5;
            color: #d60000;
            padding: 15px;
            border-radius: 12px;
            margin-bottom: 20px;
            text-align: center;
        }

        .header {
            position: relative;
        }


        .header-back {
            position: absolute;
            right: 35px;
            top: 50%;
            transform: translateY(-50%);
        }

            .header-back a {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 12px 22px;
                border-radius: 30px;
                background: #ffffff;
                color: #111827;
                text-decoration: none;
                font-weight: 700;
                transition: .3s;
                box-shadow: 0 6px 18px rgba(0,0,0,.15);
            }

                .header-back a:hover {
                    background: #f3f4f6;
                    color: #000;
                    transform: translateY(-2px);
                }

            .header-back i {
                font-size: 16px;
            }
    </style>
</head>

<body>

    <div class="header">
        <a href="/Giaodien/Index">
            <img src="/images/starlogo.png" class="logo">
        </a>

        <div class="header-center">

            <h1>StarPard Shop</h1>

            <span>CHÍNH HÃNG • UY TÍN • CHẤT LƯỢNG</span>

        </div>

        <div class="header-back">
            <a asp-controller="Giaodien" asp-action="Index">
                <i class="fa-solid fa-house"></i>
                Trang chủ
            </a>
        </div>
    </div>

    <div class="container">

        <div class="left">

            <a href="/Giaodien/Index">
                <img src="/images/starlogo.png" class="logo">
            </a>
            <h1>StarPard Shop</h1>
            <p>Shop bán giày uy tín chính hãng hàng đầu Việt Nam</p>


        </div>

        <div class="right">

            <div class="title">Đăng nhập</div>
            <div class="line"></div>

            @if (ViewBag.Error != null)
            {
                <div class="error">@ViewBag.Error</div>
            }

            <form asp-action="Index" method="post">

                <div class="input-group">
                    <i class="fa-solid fa-user"></i>
                    <input asp-for="Tendangnhap"
                           class="input-box"
                           placeholder="Tên đăng nhập">
                </div>

                <div class="input-group">
                    <i class="fa-solid fa-lock"></i>

                    <input asp-for="Matkhau"
                           type="password"
                           class="input-box"
                           id="loginPassword"
                           placeholder="Mật khẩu">

                    <i class="fa-solid fa-eye toggle-password"
                       data-target="loginPassword"></i>
                </div>

                <button class="btn">
                    Đăng nhập
                </button>

                <div class="register">
                    Chưa có tài khoản?
                    <a href="/Dangky/Index">Đăng ký ngay</a>
                </div>

                <div class="back-home">
                    <a href="/Giaodien/Index">
                        ← Quay về trang chủ
                    </a>
                </div>

            </form>

        </div>

    </div>

</body>
<script>
    document.querySelectorAll(".toggle-password").forEach(icon => {

        icon.addEventListener("click", function () {

            const input = document.getElementById(this.dataset.target);

            if (input.type === "password") {
                input.type = "text";
                this.classList.replace("fa-eye", "fa-eye-slash");
            } else {
                input.type = "password";
                this.classList.replace("fa-eye-slash", "fa-eye");
            }

        });

    });
</script>
</html>