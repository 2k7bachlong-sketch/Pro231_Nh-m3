@model duan_totnghiep.Models.Danhmuc

@{
    Layout = "_Layout";
}

<div class="delete-container">

    <div class="delete-card">

        <div class="delete-icon">

            <i class="bi bi-trash3-fill"></i>

        </div>

        <h2>Xóa danh mục</h2>

        <p>

            Bạn có chắc chắn muốn xóa danh mục này?

        </p>

        <hr />

        <div class="info-row">

            <span>Mã</span>

            <p>@Model.Madm</p>

        </div>

        <div class="info-row">

            <span>Tên</span>

            <p>@Model.Tendm</p>

        </div>

        <div class="info-row">

            <span>Mô tả</span>

            <p>@Model.Mota</p>

        </div>

        <form asp-action="Xoa">

            @Html.AntiForgeryToken()

            <input asp-for="Madm" type="hidden" />

            <div class="form-buttons">

                <button class="btn btn-danger">

                    <i class="bi bi-trash-fill"></i>

                    Xóa

                </button>

                <a asp-action="Index"
                   class="btn btn-cancel">

                    <i class="bi bi-arrow-left-circle"></i>

                    Hủy

                </a>

            </div>

        </form>

    </div>

</div>